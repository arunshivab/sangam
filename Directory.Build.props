<Project>

  <!-- Solution-wide MSBuild defaults for every project under src/ and tests/.
       tests/Directory.Build.props imports this file and relaxes a few rules. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPackable>false</IsPackable>
    <!-- rc.9 (ASVS V10.3.2): every project restores from a committed packages.lock.json, and CI (where CI=true) refuses a
         restore that would change it, so no package or version can slip in unseen. Update with the restore option
         force-evaluate when a package changes. The SDK adds one package of its own to the web projects
         (Microsoft.AspNetCore.App.Internal.Assets), at the version of the runtime it carries, so global.json names the
         exact SDK (rollForward disable): a different SDK would change that line. To move to a new SDK, change global.json
         and restore with force-evaluate in the same pull request. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>rc.14</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Sangam</Product>
    <Authors>Dr. Arun Shiva Balasubramanian</Authors>
    <Company>Dr. Arun Shiva Balasubramanian</Company>
    <Copyright>Copyright (c) 2026 Dr. Arun Shiva Balasubramanian</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://sangamid.in</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arunshivab/sangam</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
