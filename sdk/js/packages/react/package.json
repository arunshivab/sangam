{
  "name": "@sangam/react",
  "version": "1.0.0-rc.3",
  "description": "Sangam for React: the signed-in person from your back end (@sangam/node), permission checks, step-up and sign-in components. Tokens stay on the server.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec \"dist-test/test/*.test.js\""
  },
  "peerDependencies": { "react": ">=18" },
  "dependencies": { "@sangam/client": "1.0.0-rc.3" },
  "devDependencies": { "typescript": "^7.0.2", "@types/node": "^22.18.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "react": "^19.1.0", "react-dom": "^19.1.0" },
  "engines": { "node": ">=20" }
}
