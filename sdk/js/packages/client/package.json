{
  "name": "@sangam/client",
  "version": "1.0.0-rc.3",
  "description": "Sangam for JavaScript and TypeScript: who signed in and what they may do in which organisation, step-up, webhook verification, the shared audit event, the management API and access-token checks. Browser and Node.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec \"dist-test/test/*.test.js\""
  },
  "dependencies": { "jose": "^6.1.0" },
  "devDependencies": { "typescript": "^7.0.2", "@types/node": "^22.18.0" },
  "engines": { "node": ">=20" }
}
