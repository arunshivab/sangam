# Sangam - production edge (PR-10). Caddy obtains and renews TLS certificates automatically.
{
  email ops@sangamid.in
}

(sangam) {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    -Server
  }
  reverse_proxy {args[0]}:8080 {
    health_uri /health/ready
    health_interval 30s
  }
}

id.sangamid.in {
  import sangam identity
}

account.sangamid.in {
  import sangam portal
}

# OI-059 (ASVS V1.14.1): the operator console is not on the internet. Caddy serves it only on port 8443, which
# docker-compose.yml publishes on the VM's loopback address alone; operators reach it through an SSH tunnel
# (README.md, "Operator console"). The certificate is the normal public one: DNS still points admin.sangamid.in at the
# VM, so the certificate authority's check on port 80 passes, but nothing answers for this name on port 443.
admin.sangamid.in:8443 {
  import sangam admin
}

# On the public port the console's name gets nothing: the connection is closed.
admin.sangamid.in {
  abort
}

partners.sangamid.in {
  import sangam partner
}

# D-I: the imagiQa demo (the first pilot application).
demo.sangamid.in {
  import sangam demo
}
