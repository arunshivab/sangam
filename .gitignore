# .NET build output
bin/
obj/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.idea/
*.swp

# Test and coverage output
TestResults/
coverage/
*.coverage
*.trx

# Publish output
publish/
*.nupkg
*.snupkg
!localpackages/*.nupkg

# Secrets and local overrides — never commit these
appsettings.*.local.json
*.local.json
.env
.env.*
!.env.example
secrets.json
*.pfx
*.pem
*.key

# Docker volumes and Caddy state (dev stack)
deploy/.data/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Node (if a front-end toolchain is ever added)
node_modules/

# Production secrets: never committed (deploy/production/secrets/README.md)
deploy/production/secrets/*
!deploy/production/secrets/README.md

# R6: the SDK samples buffer audit events here when run from the repository.
sangam-audit/

# rc.2: Python caches from the tools/ scripts
__pycache__/
*.pyc
