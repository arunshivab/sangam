<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org for everything public; localpackages/ for imagiQa packages that
       are not published (LiPicons.Blazor). See localpackages/README.md. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="localpackages" value="localpackages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="localpackages">
      <package pattern="LiPicons.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
