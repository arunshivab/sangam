<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- id.sangamid.in — the OpenID Connect / OAuth 2 server and the eight
       authentication screens (Razor Pages; every state must work with
       JavaScript disabled). PR-02: OpenIddict server, discovery, JWKS and the
       client-credentials token endpoint. Authorization code + screens: PR-03/04. -->

  <PropertyGroup>
    <RootNamespace>Sangam.Identity.Server</RootNamespace>
    <Description>Sangam identity platform — OpenID Connect server and authentication screens.</Description>
    <UserSecretsId>sangam-identity-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sangam.Identity.Application\Sangam.Identity.Application.csproj" />
    <ProjectReference Include="..\Sangam.Identity.Infrastructure\Sangam.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Sangam.Shared\Sangam.Shared.csproj" />
    <ProjectReference Include="..\Sangam.Web.Shared\Sangam.Web.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sangam.Identity.Server.Tests" />
  </ItemGroup>

  <!-- rc.8 (ASVS V14.2.2): the development pages (/dev/outbox, /dev/callback) are left out of the production image
       altogether; the Dockerfile publishes with -p:SangamIncludeDevPages=false. Local builds and the tests keep them,
       and they still answer 404 outside Development. -->
  <PropertyGroup>
    <SangamIncludeDevPages Condition="'$(SangamIncludeDevPages)' == ''">true</SangamIncludeDevPages>
  </PropertyGroup>
  <ItemGroup Condition="'$(SangamIncludeDevPages)' != 'true'">
    <Compile Remove="Pages\Dev\**" />
    <Content Remove="Pages\Dev\**" />
    <None Remove="Pages\Dev\**" />
  </ItemGroup>

</Project>
