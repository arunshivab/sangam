@page "/dev/outbox"
@model OutboxModel
@{
    ViewData["Title"] = "Development outbox";
}

<section class="sg-card sg-card--wide">
  <h1 class="sg-card-title">Development outbox</h1>
  <p class="sg-card-body">@(Model.Shared
      ? "The last 50 e-mails and texts any Sangam host on this machine would have sent — the identity server, the portal and both consoles. Development only; nothing here leaves the machine."
      : "The last 50 e-mails and texts this server would have sent. Development only; nothing here leaves the machine.")</p>
  @if (Model.TextMessages.Count > 0)
  {
    <h2 class="sg-card-title">Text messages</h2>
    @foreach (var t in Model.TextMessages)
    {
      <article class="sg-mail">
        <div class="sg-mail-head">
          <span class="sg-mono">@Sangam.Shared.IndiaTime.Format(t.SentAt, "HH:mm:ss") IST</span>
          <span>to <span class="sg-mono">@t.Recipient</span> · <span class="sg-mono">@t.Subject</span>@(t.Host is null ? "" : " · from " + t.Host)</span>
        </div>
        <pre class="sg-mail-body">@t.Body</pre>
      </article>
    }
    <h2 class="sg-card-title">Emails</h2>
  }
  @if (Model.Messages.Count == 0)
  {
    <p class="sg-note">No messages yet. Register an account or request a password reset and come back.</p>
  }
  @foreach (var m in Model.Messages)
  {
    <article class="sg-mail">
      <div class="sg-mail-head">
        <span class="sg-mono">@Sangam.Shared.IndiaTime.Format(m.SentAt, "HH:mm:ss") IST</span>
        <span>to <span class="sg-mono">@m.Recipient</span>@(m.Host is null ? "" : " · from " + m.Host)</span>
      </div>
      <h2 class="sg-mail-subject">@m.Subject</h2>
      <pre class="sg-mail-body">@m.Body</pre>
    </article>
  }
</section>
