@page "/login/password"
@model LoginPasswordModel
@{
    ViewData["Title"] = L["Enter your password"].Value;
}

@* rc.11 (A3): the password, with "Show" on the label row and "Forgot your password?" under the button. *@
<section class="sg-card">
  <h1 class="sg-card-title">@L["Enter your password"]</h1>
  <partial name="_SigningInAs" model="@Model.Start.Identifier" />
  <partial name="_Banner" model="@(("danger", Model.Error ?? string.Empty))" />

  <form method="post" novalidate>
    <partial name="_AntibotToken" model="@Model.FormToken" />
    <input type="hidden" asp-for="ReturnUrl" />
    @* For the browser's password manager: the name the password belongs to, as typed. *@
    <input type="text" name="username" value="@Model.UsernameHint" autocomplete="username" hidden readonly />
    <div class="sg-field-group">
      <label class="sg-label" asp-for="Password">@L["Password"]</label>
      <input class="sg-field" asp-for="Password" type="password" autocomplete="current-password" autofocus required />
      <span class="sg-field-error" asp-validation-for="Password"></span>
    </div>
    <button type="submit" class="sg-btn sg-btn--primary sg-btn--block">@L["Sign in"]</button>
  </form>
  <a class="sg-tertiary" href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? "/forgot" : "/forgot?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))">@L["Forgot your password?"]</a>

  <div class="sg-cord-rule" role="presentation"></div>
  <p class="sg-alt"><a href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? "/login/method" : "/login/method?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))">@L["Choose another way to sign in"]</a></p>
</section>
