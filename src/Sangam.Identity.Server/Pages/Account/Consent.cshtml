@page
@model ConsentModel
@{
    ViewData["Title"] = L["{0} would like to use your Sangam account", Model.App.DisplayName].Value;
    ViewData["Wide"] = true;
}

<section class="sg-card sg-card--consent">
  <div class="sg-relation" aria-hidden="true">
    <span class="sg-tile" style="background:@Model.App.BrandColour">@Model.App.Glyph</span>
    <span class="sg-relation-arrow"><span class="sg-relation-glyph">→</span><span class="sg-relation-caption">@L["REQUESTS"]</span></span>
    <span class="sg-tile sg-tile--sangam"><component type="typeof(SangamMark)" render-mode="Static" param-Size="30" param-Mode="SangamMarkMode.Reversed" param-Decorative="true" /></span>
  </div>

  <h1 class="sg-card-title sg-card-title--consent">@L["{0} would like to use your Sangam account", Model.App.DisplayName]</h1>
  <p class="sg-card-body">@L["{0} is operated by {1}. It is asking for the items below; you can withdraw this at any time.", Model.App.DisplayName, Model.App.OwnerCompanyName]</p>

  <div class="sg-account-row">
    <span class="sg-avatar sg-avatar--initials" aria-hidden="true">@Model.Initials</span>
    <span class="sg-account-text"><span class="sg-account-name">@Model.User.DisplayName</span><span class="sg-account-email sg-mono">@Model.User.Email</span></span>
    <a class="sg-account-switch" href="/login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl)&switch=1">@L["Switch account"]</a>
  </div>

  <div class="sg-consent-columns">
    <div class="sg-consent-col">
      <h2 class="sg-consent-head sg-consent-head--share">@L["WILL BE SHARED"]</h2>
      <ul class="sg-share-list">
        @foreach (var item in Model.Shared)
        {
          <li><span class="sg-share-tick" aria-hidden="true">✓</span><span><span class="sg-share-claim">@item.Label</span><span class="sg-share-value">@item.Value</span></span></li>
        }
      </ul>
      <div class="sg-chips">
        @foreach (string scope in Model.Scopes)
        {
          <span class="sg-chip">@scope</span>
        }
      </div>
    </div>
    <div class="sg-consent-col sg-consent-col--not">
      <h2 class="sg-consent-head sg-consent-head--not">@L["WILL NOT BE SHARED"]</h2>
      <ul class="sg-not-list">
        <li>@L["Your password"]</li>
        <li>@L["Data held by other apps"]</li>
        <li>@L["Clinical records or prescriptions"]</li>
        <li>@L["Your sign-in history"]</li>
        <li>@L["Payment details"]</li>
      </ul>
    </div>
  </div>

  <form method="post" class="sg-consent-actions">
    <input type="hidden" asp-for="ReturnUrl" />
    <button type="submit" class="sg-btn sg-btn--secondary sg-btn--consent" asp-page-handler="Deny">@L["Cancel"]</button>
    <button type="submit" class="sg-btn sg-btn--primary sg-btn--consent sg-btn--consent-allow" asp-page-handler="Allow">@L["Allow access"]</button>
  </form>

  <p class="sg-note sg-note--centre">@L.Html("You can withdraw this at account.sangamid.in. After approval, {0}'s {1} governs what it does with the data.", Model.App.DisplayName, LocalizedMarkup.Link(Model.App.PrivacyUrl ?? "#", L["privacy policy"]))</p>
</section>
