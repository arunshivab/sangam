@page "/invite/{token}"
@model InviteModel
@{
    ViewData["Title"] = L["Invitation"].Value;
}

<section class="sg-card">
  @if (Model.View is null)
  {
    <h1 class="sg-card-title">@L["Invitation not found"]</h1>
    <p class="sg-card-body">@L["This invitation link is not valid. Ask the person who invited you to send a new one."]</p>
  }
  else
  {
    <h1 class="sg-card-title">@L["Join {0}", Model.View.OrgName]</h1>
    <p class="sg-card-body">@L.Html("You are invited to join {0} in {1} as {2}.", LocalizedMarkup.Tag("strong", Model.View.OrgName), LocalizedMarkup.Tag("strong", Model.View.AppName), LocalizedMarkup.Tag("strong", Model.View.RoleName))</p>
    @if (Model.Message is not null)
    {
      <partial name="_Banner" model="@((Model.Succeeded ? "success" : "danger", Model.Message))" />
    }
    @if (!Model.Succeeded && Model.View.State == Sangam.Identity.Application.Partners.InvitationState.Open)
    {
      <p class="sg-card-body">@L["Accepting links your Sangam account to {0} and gives you this role. {0} will ask for your permission to see your details the first time you sign in to it.", Model.View.AppName]</p>
      <form method="post">
        <button type="submit" class="sg-btn sg-btn--primary sg-btn--block">@L["Accept the invitation"]</button>
      </form>
    }
    else if (!Model.Succeeded)
    {
      <p class="sg-card-body">@Model.StateText</p>
    }
  }
  <a class="sg-tertiary" href="/account">@L["Go to your Sangam account"]</a>
</section>
