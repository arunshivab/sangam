@page "/login/new-password"
@model LoginNewPasswordModel
@{
    ViewData["Title"] = L["Choose a new password"].Value;
}

<section class="sg-card">
  <h1 class="sg-card-title">@L["Choose a new password"]</h1>
  @if (Model.Reason == "breached")
  {
    <p class="sg-card-body">@L["Your password is correct, but it has appeared in a data breach on another website, so attackers may try it. Choose a new one before you continue."]</p>
  }
  else
  {
    <p class="sg-card-body">@(Model.Partner is null ? L["Your password is correct, but an application you use now requires passwords of at least {0} characters. Choose a new one before you continue.", Model.MinimumLength] : L["Your password is correct, but {0} now requires passwords of at least {1} characters. Choose a new one before you continue.", Model.Partner.DisplayName, Model.MinimumLength])</p>
  }

  <form method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="Reason" />
    <div class="sg-field-group">
      <label class="sg-label" asp-for="NewPassword">@L["New password"]</label>
      <input class="sg-field" asp-for="NewPassword" type="password" autocomplete="new-password" minlength="@Model.MinimumLength" autofocus required data-sg-password />
      <partial name="_StrengthMeter" model="Model.Strength" />
      <span class="sg-field-error" asp-validation-for="NewPassword"></span>
    </div>
    <div class="sg-field-group">
      <label class="sg-label" asp-for="ConfirmPassword">@L["Confirm password"]</label>
      <input class="sg-field" asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
      <span class="sg-field-error" asp-validation-for="ConfirmPassword"></span>
    </div>
    <button type="submit" class="sg-btn sg-btn--primary sg-btn--block">@L["Save and continue"]</button>
  </form>

  <script src="/js/password-meter.js" defer></script>
  <p class="sg-note">@L["At least {0} characters, with an uppercase letter, a lowercase letter, a number and a symbol. Your other devices will be signed out.", Model.MinimumLength]</p>

  <div class="sg-cord-rule" role="presentation"></div>
  <p class="sg-alt"><a href="/login">@L["Back to sign in"]</a></p>
</section>
