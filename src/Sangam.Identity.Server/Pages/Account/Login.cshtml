@page
@model LoginModel
@{
    ViewData["Title"] = L["Sign in"].Value;
}

@* rc.11 (A1): one field for an email, a mobile number or a login ID; then how to sign in. The page is the same whether an
   account exists or not. People who asked to be kept on this device's list can tap their name instead of typing. *@
<section class="sg-card">
  <h1 class="sg-card-title">@L["Sign in"]</h1>
  <partial name="_Banner" model="@(("danger", Model.Error ?? string.Empty))" />
  <partial name="_Banner" model="@(("success", Model.Notice ?? string.Empty))" />

  @if (Model.PasskeyOnly)
  {
    <p class="sg-card-body">@L["{0} accepts only passkeys — your fingerprint, face or device PIN — so a stolen password is never enough.", Model.Partner!.DisplayName]</p>
    <p class="sg-note">@L.Html("No passkey yet? {0} without {1}, add one under “manage your passkeys”, then come back.", LocalizedMarkup.Link("/login", L["Sign in to your Sangam account"]), Model.Partner!.DisplayName)</p>
  }
  else
  {
    @if (Model.SharedDevice is not null)
    {
      <div class="sg-device-people" data-panel="device-tiles">
        <p class="sg-label-mono">@Model.SharedDevice.Label · @Model.SharedDevice.OrgName</p>
        @if (Model.Tiles.Count > 0)
        {
          <h2 class="sg-section-title">@L["Who’s using this device?"]</h2>
          <ul class="sg-who-list">
            @foreach (Sangam.Identity.Application.Devices.DeviceTile tile in Model.Tiles)
            {
              <li>
                <a class="sg-who" href="@Model.TileUrl(tile)">
                  <span class="sg-avatar sg-avatar--large" aria-hidden="true">@tile.Name[..1].ToUpperInvariant()</span>
                  <span class="sg-who-text">
                    <span class="sg-who-name">@tile.Name</span>
                    @if (tile.Role is not null)
                    {
                      <span class="sg-who-role">@tile.Role</span>
                    }
                    @if (tile.Locked)
                    {
                      <span class="sg-who-locked">@L["Locked · PIN"]</span>
                    }
                  </span>
                </a>
              </li>
            }
          </ul>
          <div class="sg-cord-rule" role="presentation"></div>
          <p class="sg-label-mono">@L["Someone else, sign in"]</p>
        }
      </div>
    }
    else if (Model.DevicePeople.Count > 0)
    {
      <div class="sg-device-people" data-panel="device-people">
        <p class="sg-label-mono">@L["On this device"]</p>
        <ul class="sg-device-list">
          @foreach (Sangam.Identity.Server.Authentication.DeviceAccount person in Model.DevicePeople)
          {
            <li class="sg-device-person">
              <a class="sg-device-pick" href="@Model.PickUrl(person.Key)">
                <span class="sg-avatar" aria-hidden="true">@person.FirstName[..1].ToUpperInvariant()</span>
                <span class="sg-device-text">
                  <span class="sg-device-name">@person.FirstName</span>
                  <span class="sg-device-email">@person.MaskedEmail</span>
                </span>
              </a>
              <form method="post" action="/login/forget" class="sg-device-forget">
                @Html.AntiForgeryToken()
                <input type="hidden" name="key" value="@person.Key" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="sg-link-button" aria-label="@L["Remove {0} from this device's list", person.FirstName]">@L["Remove"]</button>
              </form>
            </li>
          }
        </ul>
        <div class="sg-cord-rule" role="presentation"></div>
        <p class="sg-label-mono">@L["Someone else"]</p>
      </div>
    }

    <form method="post" novalidate>
      <partial name="_Antibot" />
      <input type="hidden" asp-for="ReturnUrl" />
      <div class="sg-field-group">
        <label class="sg-label" asp-for="Identifier">@L["Email, mobile number or login ID"]</label>
        <input class="sg-field" asp-for="Identifier" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus="@(Model.DevicePeople.Count == 0 && Model.Tiles.Count == 0)" required />
        <span class="sg-field-error" asp-validation-for="Identifier"></span>
      </div>
      @if (Model.SharedDevice is null)
      {
      <label class="sg-check">
        <input type="checkbox" asp-for="Remember" />
        <span>
          <span class="sg-check-label">@L["Keep me on this device's list"]</span>
          <span class="sg-check-hint">@L["For a computer you share with colleagues. Only your first name and part of your email are shown, and you can remove yourself."]</span>
        </span>
      </label>
      }
      <button type="submit" class="sg-btn sg-btn--primary sg-btn--block">@L["Continue"]</button>
    </form>
  }

  @if (Model.PasskeysEnabled)
  {
    @if (!Model.PasskeyOnly)
    {
      <p class="sg-or" role="presentation"><span>@L["or"]</span></p>
    }
    <button type="button" class="sg-btn @(Model.PasskeyOnly ? "sg-btn--primary" : "sg-btn--secondary") sg-btn--block sg-passkey-signin" hidden data-passkey-signin
            data-options-url="/login/passkey?handler=Options" data-verify-url="/login/passkey?handler=Verify@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "&returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))"
            data-message="passkey-message" data-text-failed="@L["That passkey could not sign you in."]" data-text-cancelled="@L["The passkey request was cancelled or is not available on this device."]">@L["Sign in with a passkey"]</button>
    <p class="sg-field-error" id="passkey-message" hidden></p>
    <script src="/js/passkeys.js" defer></script>
  }

  <div class="sg-cord-rule" role="presentation"></div>
  <p class="sg-alt">@L["New to Sangam?"] <a href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? "/register" : "/register?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))">@L["Create an account"]</a></p>
</section>
