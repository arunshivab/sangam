@page "/account/password"
@model PasswordModel
@{
    ViewData["Title"] = L["Change your password"].Value;
}

<section class="sg-card">
  <h1 class="sg-card-title">@L["Change your password"]</h1>
  <p class="sg-card-body">@L["Enter the password you use now, then the new one. Your other devices will be signed out, and we will e-mail you to confirm."]</p>

  <form method="post" novalidate>
    <div class="sg-field-group">
      <label class="sg-label" asp-for="CurrentPassword">@L["Current password"]</label>
      <input class="sg-field" asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus required />
      <span class="sg-field-error" asp-validation-for="CurrentPassword"></span>
    </div>
    <div class="sg-field-group">
      <label class="sg-label" asp-for="NewPassword">@L["New password"]</label>
      <input class="sg-field" asp-for="NewPassword" type="password" autocomplete="new-password" minlength="@Model.MinimumLength" required data-sg-password />
      <partial name="_StrengthMeter" model="Model.Strength" />
      <span class="sg-field-error" asp-validation-for="NewPassword"></span>
    </div>
    <div class="sg-field-group">
      <label class="sg-label" asp-for="ConfirmPassword">@L["Confirm password"]</label>
      <input class="sg-field" asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
      <span class="sg-field-error" asp-validation-for="ConfirmPassword"></span>
    </div>
    <button type="submit" class="sg-btn sg-btn--primary sg-btn--block">@L["Change password"]</button>
  </form>

  <script src="/js/password-meter.js" defer></script>
  <p class="sg-note">@L["At least {0} characters, with an uppercase letter, a lowercase letter, a number and a symbol. Your other devices will be signed out.", Model.MinimumLength]</p>

  <div class="sg-cord-rule" role="presentation"></div>
  <p class="sg-alt"><a href="/forgot">@L["Forgotten your current password? Reset it with a code instead"]</a></p>
  <a class="sg-tertiary" href="/account">@L["Back to your account"]</a>
</section>
