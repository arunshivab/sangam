@page
@model ForgotModel
@{
    ViewData["Title"] = L["Reset your password"].Value;
}

<section class="sg-card">
  <h1 class="sg-card-title">@L["Reset your password"]</h1>
  <p class="sg-card-body">@L["Enter the email you registered with. If an account exists, we will send a reset code."]</p>

  <form method="post" novalidate>
    <partial name="_Antibot" />
    <div class="sg-field-group">
      <label class="sg-label" asp-for="Email">@L["Email"]</label>
      <input class="sg-field" asp-for="Email" type="email" autocomplete="username" inputmode="email" autofocus required />
      <span class="sg-field-error" asp-validation-for="Email"></span>
    </div>
    <button type="submit" class="sg-btn sg-btn--primary sg-btn--block">@L["Send reset code"]</button>
  </form>

  <p class="sg-note">@L["For your safety we show the same confirmation whether or not an account exists."]</p>

  <div class="sg-cord-rule" role="presentation"></div>
  <p class="sg-alt"><a href="/login">@L["Back to sign in"]</a></p>
</section>
