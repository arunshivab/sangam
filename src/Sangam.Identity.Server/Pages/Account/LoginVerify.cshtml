@page
@model LoginVerifyModel
@{
    ViewData["Title"] = L["Enter your sign-in code"].Value;
}

<section class="sg-card">
  <div class="sg-circle sg-circle--pending" aria-hidden="true"><span class="sg-cord-dot sg-cord-dot--solo"></span></div>
  @if (Model.ViaSms)
  {
    <h1 class="sg-card-title sg-card-title--centre">@L["Check your phone"]</h1>
    @if (Model.MaskedMobile is not null)
    {
      <p class="sg-card-body sg-card-body--centre">@L.Html("We texted a 6-digit sign-in code to {0}. It is valid for 10 minutes and can be used once.", LocalizedMarkup.Tag("span", Model.MaskedMobile, "sg-mono sg-nowrap"))</p>
    }
    else
    {
      <p class="sg-card-body sg-card-body--centre">@L["If your account has a verified mobile number, we have texted a 6-digit sign-in code to it. It is valid for 10 minutes and can be used once."]</p>
    }
  }
  else
  {
    <h1 class="sg-card-title sg-card-title--centre">@L["Check your email"]</h1>
    <p class="sg-card-body sg-card-body--centre">@L["We sent a 6-digit sign-in code. It is valid for 10 minutes and can be used once."]</p>
  }
  <partial name="_Banner" model="@(("info", Model.Notice ?? string.Empty))" />
  <partial name="_Banner" model="@(("danger", Model.Error ?? string.Empty))" />

  <form method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="sg-field-group">
      <label class="sg-label" asp-for="Code">@L["Sign-in code"]</label>
      <input class="sg-field sg-field--code" asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="7" autofocus required />
      <span class="sg-field-error" asp-validation-for="Code"></span>
    </div>
    <button type="submit" class="sg-btn sg-btn--primary sg-btn--block">@L["Continue"]</button>
  </form>

  <form method="post" asp-page-handler="Resend" class="sg-resend">
    <input type="hidden" asp-for="ReturnUrl" />
    @if (Model.ResendIn > 0)
    {
      <button type="submit" class="sg-btn sg-btn--secondary sg-btn--block" data-resend-in="@Model.ResendIn" data-resend-wait="@L["Resend in {0}", "{0}"]" data-resend-ready="@L["Resend sign-in code"]">@L["Resend in {0}", Model.ResendLabel]</button>
    }
    else
    {
      <button type="submit" class="sg-btn sg-btn--secondary sg-btn--block">@L["Resend sign-in code"]</button>
    }
  </form>

  @if (Model.SmsOffered)
  {
    <form method="post" asp-page-handler="@(Model.ViaSms ? "email" : "sms")" class="sg-switch-channel">
      <input type="hidden" asp-for="ReturnUrl" />
      <button type="submit" class="sg-link-button">@(Model.ViaSms ? L["Email me the code instead"] : L["Text the code to my mobile instead"])</button>
    </form>
  }

  <div class="sg-cord-rule" role="presentation"></div>
  <p class="sg-alt"><a href="/login">@L["Use a different account"]</a> @L["· Stuck?"] <a href="mailto:help@sangamid.in">help@sangamid.in</a></p>
</section>
<script src="/js/resend.js" defer></script>
