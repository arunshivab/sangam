@page
@model IndexModel
@{
    ViewData["Title"] = L["SangamID"].Value;
}

@* rc.5: the identity server's front door, for anyone who arrives at id.sangamid.in itself. *@
<section class="sg-card">
  <h1 class="sg-card-title">@L["One sign-in for the applications you use"]</h1>
  <p class="sg-card-body">@L["Sangam is where you sign in to applications that use it, such as hospital and clinic software. Your account, your sessions and the consents you have given are in one place, and you decide which applications see what."]</p>

  <a class="sg-btn sg-btn--primary sg-btn--block" href="/account">@L["Manage your account"]</a>
  <a class="sg-tertiary" href="/register">@L["Create an account"]</a>

  <div class="sg-cord-rule" role="presentation"></div>

  <p class="sg-note">@L["Applications send you here when you sign in to them. If you reached this page from a link in an e-mail or a message you did not expect, close it: Sangam never asks for your password in an e-mail."]</p>
  <p class="sg-note"><a href="/.well-known/security.txt">@L["Report a security problem"]</a></p>

  @if (Model.ShowDevFlowLink)
  {
    <h2 class="sg-section-label">@L["Development only"]</h2>
    <a class="sg-btn sg-btn--secondary sg-btn--block" href="@Model.DevFlowUrl">@L["Start a sign-in as the sample partner app"]</a>
  }

  <p class="sg-meta">@L["Version {0}", Model.Version]</p>
</section>
