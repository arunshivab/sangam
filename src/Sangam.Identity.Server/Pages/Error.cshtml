@page
@model ErrorModel
@{
    ViewData["Title"] = L["Something went wrong"].Value;
}

<section class="sg-card">
  <h1 class="sg-card-title">@L["Something went wrong"]</h1>
  <p class="sg-card-body">@L.Html("Sangam could not complete that request. Nothing about your account has changed. Try again, or write to {0} and quote the reference below.", LocalizedMarkup.Link("mailto:help@sangamid.in", "help@sangamid.in"))</p>
  <p class="sg-meta">@L["reference"] <code>@Model.RequestId</code></p>
  <a class="sg-btn sg-btn--secondary sg-btn--block" href="/login">@L["Back to sign in"]</a>
</section>
