@model PasswordStrengthResult
@{
    string level = Model.Verdict switch
    {
        PasswordVerdict.Strong => "strong",
        PasswordVerdict.Fair => "fair",
        _ => "weak",
    };
    string verdict = Model.Verdict switch
    {
        PasswordVerdict.Strong => "Strong",
        PasswordVerdict.Fair => "Fair",
        _ => Model.Segments == 0 ? "" : "Too weak",
    };
}
<div class="sg-meter sg-meter--@level" data-sg-meter aria-hidden="true">
  @for (int i = 0; i < 4; i++)
  {
    <span class="sg-meter-seg @(i < Model.Segments ? "sg-meter-seg--on" : "")"></span>
  }
</div>
<p class="sg-meter-caption" data-sg-caption>
  <span class="sg-meter-verdict sg-meter-verdict--@level" data-sg-verdict>@verdict</span>
  @foreach ((string label, bool met) in Model.Tokens)
  {
    <span class="sg-token @(met ? "sg-token--met" : "")" data-sg-token="@label"><span class="sg-token-mark" aria-hidden="true">@(met ? "✓" : "·")</span>@label</span>
  }
</p>
