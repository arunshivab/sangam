@model PasswordStrengthResult
@{
    string colour = Model.Verdict switch
    {
        PasswordVerdict.Strong => "strong",
        PasswordVerdict.Fair => "fair",
        _ => "weak",
    };
    string verdict = Model.Segments == 0 ? "" : Model.Verdict switch
    {
        PasswordVerdict.Strong => "Strong",
        PasswordVerdict.Fair => "Fair",
        _ => "Too weak",
    };
}
<div class="sg-meter sg-meter--@colour" aria-hidden="true">
  @for (int i = 1; i <= 4; i++)
  {
    <span class="sg-meter-seg @(i <= Model.Segments ? "sg-meter-seg--on" : "")"></span>
  }
</div>
<div class="sg-meter-caption">
  <span class="sg-meter-verdict sg-meter-verdict--@colour">@verdict</span>
  <span class="sg-meter-hint">@PasswordStrength.MinimumLength+ characters, upper, lower, number, symbol</span>
</div>
