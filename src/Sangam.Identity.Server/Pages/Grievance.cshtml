@page "/privacy/grievance"
@model GrievanceModel
@{
    ViewData["Title"] = L["Raise a grievance"].Value;
}

<section class="sg-card sg-doc">
  <h1 class="sg-card-title">@L["Raise a grievance"]</h1>
  <p class="sg-card-body">@L["If you are unhappy with how Sangam handles your personal data, tell us. Write to:"]</p>
  <dl class="sg-card-body">
    <dt>@L["Grievance officer"]</dt>
    <dd>@(Model.OfficerName ?? L["To be named before Sangam opens to the public"])</dd>
    <dt>@L["Email"]</dt>
    <dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
    @if (Model.Address is not null)
    {
      <dt>@L["Post"]</dt>
      <dd>@Model.Address</dd>
    }
  </dl>
  <p class="sg-card-body">@L["Write from the email address of your Sangam account, describe what happened and when, and say what you would like us to do."]</p>
  @if (Model.AcknowledgeDays is not null && Model.ResponseDays is not null)
  {
    <p class="sg-card-body">@L["We acknowledge every grievance within {0} working days and resolve it within {1} days of receiving it. Every grievance is logged.", Model.AcknowledgeDays, Model.ResponseDays]</p>
  }
  else if (Model.ResponseDays is not null)
  {
    <p class="sg-card-body">@L["We will answer within {0} days.", Model.ResponseDays]</p>
  }
  <p class="sg-card-body">@L["If you are not satisfied with our answer, you may complain to the Data Protection Board of India under the Digital Personal Data Protection Act, 2023."]</p>
  <p class="sg-card-body">@L.Html("Many things you can do yourself in {0}: download your data, correct your details, see your activity, withdraw an app's access, and delete your account.", LocalizedMarkup.Link("/account", L["your account"]))</p>
</section>
