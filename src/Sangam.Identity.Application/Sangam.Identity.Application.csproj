<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application services, commands, queries and the interfaces that
       Sangam.Identity.Infrastructure implements. Knows the domain; knows
       nothing about EF Core, HTTP or any concrete provider. -->

  <PropertyGroup>
    <RootNamespace>Sangam.Identity.Application</RootNamespace>
    <Description>Sangam identity platform — application layer (use cases and abstractions).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- rc.5: the built-in list of common passwords (ASVS V2.1.7 fallback); its source and licence are beside it. -->
    <EmbeddedResource Include="Security\Data\common-passwords.txt.gz" LogicalName="Sangam.Identity.Application.Security.common-passwords.txt.gz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sangam.Identity.Domain\Sangam.Identity.Domain.csproj" />
    <ProjectReference Include="..\Sangam.Shared\Sangam.Shared.csproj" />
  </ItemGroup>

</Project>
