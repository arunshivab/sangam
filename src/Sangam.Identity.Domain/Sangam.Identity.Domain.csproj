<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core entities and rules. Depends on the BCL, Sangam.Shared and
       Microsoft.Extensions.Identity.Stores (for IdentityUser<Guid>, the base of
       SangamUser). Never EF Core, never ASP.NET Core, never a provider
       (enforced by tests/Sangam.Identity.Domain.Tests/LayeringTests). -->

  <PropertyGroup>
    <RootNamespace>Sangam.Identity.Domain</RootNamespace>
    <Description>Sangam identity platform — domain entities, value objects and domain events.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sangam.Shared\Sangam.Shared.csproj" />
  </ItemGroup>

</Project>
