@page "/profile"
@inject IPortalService Portal
@inject IAccountService Accounts
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime Js
@inject IMfaService Mfa
@inject IAdminService Admin
@inject IEmailChangeService EmailChanges
@inject Sangam.Identity.Application.Passkeys.IPasskeyService Passkeys
@inject Sangam.Identity.Application.Sms.ISmsCodeService Sms
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject Sangam.Identity.Infrastructure.Verification.DigiLockerSettings DigiLocker

<PageTitle>@L["Personal details · sangam"]</PageTitle>

<PageHeader Title="@L["Personal details"].Value" Subtitle="@L["What Sangam knows about you, and what you can do with it."].Value" />

@* PR-26: the person has just come back from DigiLocker, so the outcome goes at the top where they land. *@
@if (DigiLockerOutcome is not null && Outcome(DigiLockerOutcome) is (string text, bool good))
{
  <p class="sg-banner sg-banner--top @(good ? "sg-banner--success" : "sg-banner--error")" role="status" data-digilocker="@DigiLockerOutcome">@text</p>
}

@if (_user is null)
{
  <p class="sg-note">@L["Loading…"]</p>
}
else
{
  <section class="sg-panel">
    <h2 class="sg-panel-title">@L["Your details"]</h2>
    <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="profile">
      <DataAnnotationsValidator />
      <div class="sg-two">
        <label class="sg-field-group"><span class="sg-label">@L["First name"]</span><InputText class="sg-field" @bind-Value="_form.FirstName" disabled="@Verified" /></label>
        <label class="sg-field-group"><span class="sg-label">@L["Last name"]</span><InputText class="sg-field" @bind-Value="_form.LastName" disabled="@Verified" /></label>
      </div>
      @if (Verified)
      {
        <p class="sg-note" data-identity="verified">@L["Your name, date of birth and gender are verified with DigiLocker, so they cannot be changed here. To change them, remove the verification below."]</p>
      }
      <div class="sg-two">
        <label class="sg-field-group">
          <span class="sg-label">@L["Gender"]</span>
          <InputSelect class="sg-field" @bind-Value="_form.Gender" disabled="@Verified">
            <option value="female">@L["Female"]</option>
            <option value="male">@L["Male"]</option>
            <option value="other">@L["Other"]</option>
            <option value="prefer_not_to_say">@L["Prefer not to say"]</option>
          </InputSelect>
        </label>
        <label class="sg-field-group">
          <span class="sg-label">@L["Language"]</span>
          <InputSelect class="sg-field" @bind-Value="_form.Locale">
            @* Each language in its own script, as in the language picker (PR-18). Tamil stays for people who chose it; its screens are not translated yet. *@
            <option value="en-IN">English</option>
            <option value="hi-IN">हिन्दी</option>
            <option value="ml-IN">മലയാളം</option>
            <option value="ta-IN">தமிழ்</option>
          </InputSelect>
        </label>
      </div>
      <div class="sg-field-group">
        <label class="sg-label" for="profile-mobile">@L["Mobile"]</label>
        <div class="sg-phone">
          <InputSelect class="sg-field sg-field--dial" @bind-Value="_form.CountryIso" aria-label="@L["Country dialling code"]">
            @foreach (var country in CountryCodes.All)
            {
              <option value="@country.Iso">@CountryCodes.OptionLabel(country)</option>
            }
          </InputSelect>
          <InputText id="profile-mobile" class="sg-field" @bind-Value="_form.MobileNumber" type="tel" inputmode="numeric" autocomplete="tel-national" />
        </div>
        @if (_user?.MobileVerified == true)
        {
          <p class="sg-note" data-mobile="verified">@L["Verified. Changing it makes the new number unverified until you confirm it with a texted code."]</p>
        }
        else if (Sms.Enabled && Sms.IsCountryAllowed(_user?.Mobile))
        {
          <p class="sg-note" data-mobile="unverified">@L.Markup("Not yet verified. {0} so sign-in codes can be sent to it.", LocalizedMarkup.Link(MobileUrl, L["Verify it with a texted code"]))</p>
        }
        else
        {
          <p class="sg-note" data-mobile="unverified">@L["Not yet verified. Changing it keeps it unverified until it can be confirmed with a code."]</p>
        }
      </div>
      @if (_error is not null)
      {
        <p class="sg-field-error">@_error</p>
      }
      <button type="submit" class="sg-btn sg-btn--primary" disabled="@_working">@L["Save changes"]</button>
      <ValidationSummary class="sg-field-error" />
    </EditForm>

    <dl class="sg-facts">
      <div><dt>@L["Email"]</dt><dd>@_user.Email · @(_user.EmailVerified ? L["verified"] : L["not verified"])</dd></div>
      <div><dt>@L["Date of birth"]</dt><dd>@_user.DateOfBirth.ToString("d MMMM yyyy", CultureInfo.CurrentCulture)</dd></div>
      <div><dt>@L["Member since"]</dt><dd>@IndiaTime.LongDate(_user.CreatedAt)</dd></div>
    </dl>
    <div class="sg-field-group" aria-live="polite">
      <span class="sg-label">@L["Change your email"]</span>
      @if (_pendingChange is null)
      {
        <div class="sg-two">
          <label class="sg-field-group"><span class="sg-label">@L["New email"]</span><input class="sg-field" type="email" autocomplete="email" @bind="_newEmail" /></label>
          <label class="sg-field-group"><span class="sg-label">@L["Current password"]</span><input class="sg-field" type="password" autocomplete="current-password" @bind="_currentPassword" /></label>
        </div>
        <button type="button" class="sg-btn sg-btn--secondary" disabled="@_working" @onclick="RequestEmailChangeAsync">@L["Send a code to the new address"]</button>
      }
      else
      {
        <p class="sg-note">@L.Markup("Enter the code we sent to {0}. Until you do, your account keeps its current address.", LocalizedMarkup.Tag("strong", _pendingChange.NewEmail))</p>
        <label class="sg-field-group"><span class="sg-label">@L["Code"]</span><input class="sg-field" inputmode="numeric" autocomplete="one-time-code" @bind="_changeCode" /></label>
        <button type="button" class="sg-btn sg-btn--primary" disabled="@_working" @onclick="ConfirmEmailChangeAsync">@L["Change my email"]</button>
        <button type="button" class="sg-btn sg-btn--secondary" disabled="@_working" @onclick="CancelEmailChangeAsync">@L["Cancel"]</button>
      }
      @if (_changeMessage is not null)
      {
        <p class="sg-note">@_changeMessage</p>
      }
      @if (_changeError is not null)
      {
        <p class="sg-field-error">@_changeError</p>
      }
    </div>
    @if (!Verified)
    {
      <p class="sg-note">
        @if (DigiLocker.Enabled)
        {
          @L.Markup("Your date of birth is fixed here because applications rely on it to identify you. If it is wrong, verify with DigiLocker below to take the one on your government record, or write to {0}.", LocalizedMarkup.Link("mailto:help@sangamid.in", "help@sangamid.in"))
        }
        else
        {
          @L.Markup("Your date of birth is fixed here because applications rely on it to identify you; it will become changeable once you can prove your identity with DigiLocker. Write to {0} if it is wrong.", LocalizedMarkup.Link("mailto:help@sangamid.in", "help@sangamid.in"))
        }
      </p>
    }
  </section>

  @if (Verified || DigiLocker.Enabled)
  {
    <section class="sg-panel" data-panel="identity">
      <h2 class="sg-panel-title">@L["Verified identity"]</h2>
      @if (Verified)
      {
        <p class="sg-panel-body">@L["Verified with DigiLocker on {0}. Applications that ask for your profile are told your details are verified.", IndiaTime.LongDate(_user.IdentityVerifiedAt!.Value)]</p>
        <form method="post" action="/verify/digilocker/remove">
          <AntiforgeryToken />
          <button type="submit" class="sg-btn sg-btn--secondary">@L["Remove the verification"]</button>
        </form>
      }
      else
      {
        <p class="sg-panel-body">@L["DigiLocker can confirm your name, date of birth and gender from your government records. Your Sangam profile then takes DigiLocker's values, and they stay locked until you remove the verification. Sangam keeps only those three details: never your Aadhaar number, and no documents."]</p>
        <form method="post" action="/verify/digilocker" class="sg-verify-form">
          <AntiforgeryToken />
          <label class="sg-check"><input type="checkbox" name="agree" value="true" required /> @L["I agree that my name, date of birth and gender will be replaced with DigiLocker's and locked."]</label>
          <button type="submit" class="sg-btn sg-btn--primary">@L["Verify with DigiLocker"]</button>
        </form>
      }
    </section>
  }

  <section class="sg-panel">
    <h2 class="sg-panel-title" id="sign-in-mode-title">@L["How you sign in"]</h2>
    <div class="sg-field-group">
      <InputSelect class="sg-field" aria-labelledby="sign-in-mode-title" Value="_mode" ValueChanged="@((string v) => _mode = v)" ValueExpression="() => _mode">
        <option value="password">@L["Email and password"]</option>
        <option value="password_and_otp">@L["Password, then an emailed code"]</option>
        <option value="otp_only">@L["An emailed code only (no password)"]</option>
      </InputSelect>
      <p class="sg-note">@L["An application can require a stronger method than the one you choose here."]</p>
    </div>
    <button type="button" class="sg-btn sg-btn--secondary" @onclick="SaveModeAsync">@L["Save preference"]</button>
  </section>

  <section class="sg-panel" data-panel="password">
    <h2 class="sg-panel-title">@L["Password"]</h2>
    <p class="sg-panel-body">@L["Change your password on the Sangam sign-in site. You will be asked for the current one first, and your other devices will be signed out."]</p>
    <a class="sg-btn sg-btn--secondary" href="@PasswordUrl">@L["Change your password"]</a>
  </section>

  @if (Passkeys.Enabled)
  {
    <section class="sg-panel" data-panel="passkeys">
      <h2 class="sg-panel-title">@L["Passkeys"]</h2>
      @if (_passkeys.Count == 0)
      {
        <p class="sg-panel-body">@L["Sign in with your fingerprint, face or device PIN instead of a password. A passkey only works on Sangam's own site, so a fake site cannot steal it."]</p>
      }
      else
      {
        <p class="sg-panel-body">@(_passkeys.Count == 1 ? L["1 passkey is set up: {0}.", string.Join(", ", _passkeys.Select(p => p.Name))] : L["{0} passkeys are set up: {1}.", _passkeys.Count, string.Join(", ", _passkeys.Select(p => p.Name))])</p>
      }
      <p class="sg-note">@L["Passkeys are added and removed on the Sangam sign-in site, which is the only place they work."]</p>
      <a class="sg-btn sg-btn--secondary" href="@PasskeysUrl">@(_passkeys.Count == 0 ? L["Add a passkey"] : L["Manage passkeys"])</a>
    </section>
  }

  <section class="sg-panel">
    <h2 class="sg-panel-title">@L["Two-step sign-in"]</h2>
    @if (_mfaEnrolled)
    {
      <p class="sg-panel-body">@L["An authenticator app is set up on your account. You are asked for a code from it every time you sign in."]</p>
      @if (_isOperator)
      {
        <p class="sg-note">@L["You hold Sangam console access, so two-step sign-in cannot be switched off."]</p>
      }
      else
      {
        <button type="button" class="sg-btn sg-btn--danger" @onclick="DisableMfaAsync" disabled="@_working">@L["Remove the authenticator"]</button>
      }
    }
    else if (_enrolment is null)
    {
      <p class="sg-panel-body">@L["Add a second step with an authenticator app such as Google Authenticator, Aegis or 1Password. It is stronger than an emailed code, because it does not depend on your mailbox."]</p>
      <button type="button" class="sg-btn sg-btn--secondary" @onclick="BeginMfaAsync" disabled="@_working">@L["Set up an authenticator app"]</button>
    }
    else
    {
      <p class="sg-panel-body">@L["Scan this with your authenticator app, then type the six-digit code it shows."]</p>
      <div class="sg-qr">@((MarkupString)_enrolment.QrCodeSvg)</div>
      <p class="sg-note">@L.Markup("Cannot scan? Type this key into the app instead, and choose {0}:", LocalizedMarkup.Tag("strong", L["Time based"]))</p>
      <p class="sg-key-box"><span class="sg-mono sg-key">@_enrolment.SharedKey</span></p>
      <p class="sg-note">@L["It contains only letters and the digits 2 to 7 — never 0, 1, 8 or 9. Spaces don't matter."]</p>
      <div class="sg-field-group">
        <label class="sg-label" for="mfa-code">@L["Code from the app"]</label>
        <input id="mfa-code" class="sg-field sg-field--confirm" @bind="_mfaCode" @bind:event="oninput" inputmode="numeric" maxlength="7" />
      </div>
      @if (_mfaError is not null)
      {
        <p class="sg-field-error">@_mfaError</p>
      }
      <div class="sg-confirm-actions">
        <button type="button" class="sg-btn sg-btn--secondary" @onclick="() => _enrolment = null">@L["Cancel"]</button>
        <button type="button" class="sg-btn sg-btn--primary" @onclick="ConfirmMfaAsync" disabled="@_working">@L["Turn on two-step sign-in"]</button>
      </div>
    }

    @if (_recoveryCodes.Count > 0)
    {
      <div class="sg-recovery">
        <h3 class="sg-recovery-title">@L["Save these recovery codes now"]</h3>
        <p class="sg-note">@L["Each one signs you in once if you lose your phone. They are shown only this time."]</p>
        <ul class="sg-recovery-list">
          @foreach (string recoveryCode in _recoveryCodes)
          {
            <li class="sg-mono">@recoveryCode</li>
          }
        </ul>
        <button type="button" class="sg-btn sg-btn--secondary" @onclick="DownloadRecoveryAsync">@L["Download them"]</button>
      </div>
    }
  </section>

  <section class="sg-panel">
    <h2 class="sg-panel-title">@L["A copy of your data"]</h2>
    <p class="sg-panel-body">@L["Download everything Sangam holds about you as a JSON file: your profile, the applications you have allowed, your organisations and roles, your sessions and your full activity log. Your password is not included — it is stored only as a one-way hash."]</p>
    <button type="button" class="sg-btn sg-btn--secondary" @onclick="DownloadAsync" disabled="@_working">@L["Download my data"]</button>
  </section>

  <section class="sg-panel sg-panel--danger">
    <h2 class="sg-panel-title">@L["Delete your account"]</h2>
    @if (_deletion?.Requested == true)
    {
      <p class="sg-panel-body">
        @L.Markup("Your account is scheduled for deletion on {0}. Until then you can change your mind and everything comes back. After that date your name, email, mobile and password are destroyed permanently.", LocalizedMarkup.Tag("strong", (_deletion.PurgeAfter is DateTimeOffset purge ? IndiaTime.LongDate(purge) : null)))
        @if (_deletion.OnHold)
        {
          <span> @L["A Sangam operator has placed a hold on this account, so the deletion will not run until the hold is cleared."]</span>
        }
      </p>
      <button type="button" class="sg-btn sg-btn--primary" @onclick="CancelDeletionAsync" disabled="@_working">@L["Keep my account"]</button>
    }
    else
    {
      <p class="sg-panel-body">
        @L["Deleting your account signs you out everywhere, revokes every application's access immediately, and blocks sign-in. Your data is kept for 30 days in case you change your mind, then permanently destroyed. Records that the law requires us to retain — an anonymous audit trail of what happened and when — survive deletion."]
      </p>
      @if (_confirmingDelete)
      {
        <p class="sg-confirm-body">@L.Markup("Type {0} to confirm.", LocalizedMarkup.Tag("strong", "DELETE"))</p>
        <input class="sg-field sg-field--confirm" @bind="_confirmText" @bind:event="oninput" aria-label="@L["Type DELETE to confirm"]" />
        <div class="sg-confirm-actions">
          <button type="button" class="sg-btn sg-btn--secondary" @onclick="() => _confirmingDelete = false">@L["Cancel"]</button>
          <button type="button" class="sg-btn sg-btn--danger" @onclick="DeleteAsync" disabled="@(_working || _confirmText != "DELETE")">@L["Delete my account"]</button>
        </div>
      }
      else
      {
        <button type="button" class="sg-btn sg-btn--danger" @onclick="() => _confirmingDelete = true">@L["Delete my account"]</button>
      }
    }
  </section>
}

@if (_message is not null)
{
  <p class="sg-banner sg-banner--success" role="status">@_message</p>
}

@code {
    /// <summary>PR-26: how a DigiLocker round trip ended, from the portal's verification endpoints.</summary>
    [SupplyParameterFromQuery(Name = "digilocker")]
    public string? DigiLockerOutcome { get; set; }

    private UserSummary? _user;
    private DeletionState? _deletion;
    private readonly ProfileForm _form = new();
    private string _mode = "password";
    private bool _confirmingDelete;
    private string _confirmText = string.Empty;
    private bool _working;
    private string? _message;
    private string? _error;
    private bool _mfaEnrolled;
    private bool _isOperator;
    private MfaEnrolment? _enrolment;
    private string _mfaCode = string.Empty;
    private string? _mfaError;
    private IReadOnlyList<string> _recoveryCodes = [];
    private Guid _userId;
    private PendingEmailChange? _pendingChange;
    private string _newEmail = string.Empty;
    private string _currentPassword = string.Empty;
    private string _changeCode = string.Empty;
    private string? _changeMessage;
    private string? _changeError;
    private IReadOnlyList<Sangam.Identity.Application.Passkeys.PasskeyRow> _passkeys = [];

    private bool Verified => _user?.IdentityVerifiedAt is not null;

    private string MobileUrl => (Configuration["Sangam:Authority"] ?? "https://id.sangamid.in").TrimEnd('/') + "/account/mobile";

    private string PasskeysUrl => (Configuration["Sangam:Authority"] ?? "https://id.sangamid.in").TrimEnd('/') + "/account/passkeys";

    private string PasswordUrl => (Configuration["Sangam:Authority"] ?? "https://id.sangamid.in").TrimEnd('/') + "/account/password";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = PortalUser.Id(state.User) ?? Guid.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId == Guid.Empty)
        {
            return;
        }

        _user = await Accounts.FindByIdAsync(_userId);
        _mfaEnrolled = await Mfa.IsEnrolledAsync(_userId);
        _isOperator = await Admin.GetRoleAsync(_userId) is not null;
        _deletion = await Portal.GetDeletionStateAsync(_userId);
        _pendingChange = await EmailChanges.GetPendingAsync(_userId);
        _passkeys = Passkeys.Enabled ? await Passkeys.ListAsync(_userId) : [];
        if (_user is not null)
        {
            _form.FirstName = _user.FirstName;
            _form.LastName = _user.LastName;
            _form.Locale = _user.Locale;
            _form.Gender = Genders.ToCode(_user.Gender);
            (_form.CountryIso, _form.MobileNumber) = SplitMobile(_user.Mobile);
            _mode = SignInModes.ToCode(_user.SignInPreference);
        }
    }

    private async Task RequestEmailChangeAsync()
    {
        _working = true;
        _changeMessage = null;
        _changeError = null;
        EmailChangeResult result = await EmailChanges.RequestAsync(_userId, _newEmail, _currentPassword);
        _currentPassword = string.Empty;
        _working = false;
        if (result.Status == EmailChangeStatus.CodeSent)
        {
            _changeMessage = L[result.Message ?? string.Empty];
            _pendingChange = await EmailChanges.GetPendingAsync(_userId);
            return;
        }

        _changeError = L[result.Message ?? string.Empty];
    }

    private async Task ConfirmEmailChangeAsync()
    {
        _working = true;
        _changeMessage = null;
        _changeError = null;
        EmailChangeResult result = await EmailChanges.ConfirmAsync(_userId, _changeCode);
        _changeCode = string.Empty;
        _working = false;
        if (result.Status == EmailChangeStatus.Changed)
        {
            _changeMessage = L[result.Message ?? string.Empty];
            _pendingChange = null;
            _newEmail = string.Empty;
            _user = await Accounts.FindByIdAsync(_userId) ?? _user;
            return;
        }

        _changeError = L[result.Message ?? string.Empty];
    }

    private async Task CancelEmailChangeAsync()
    {
        await EmailChanges.CancelAsync(_userId);
        _pendingChange = null;
        _changeMessage = L["The change was cancelled. Your address is unchanged."];
        _changeError = null;
    }

    private async Task SaveAsync()
    {
        _working = true;
        _error = null;
        Genders.TryParse(_form.Gender, out Gender gender);
        ProfileUpdateResult result = await Portal.UpdateProfileAsync(
            _userId,
            new ProfileUpdate(_form.FirstName, _form.LastName, _form.Locale, gender, _form.CountryIso, _form.MobileNumber),
            null);
        _working = false;

        if (!result.Succeeded)
        {
            _error = L[result.Message ?? string.Empty];
            return;
        }

        _message = result.MobileChanged
            ? L["Your details have been saved. Your new mobile number is not verified yet."]
            : L["Your details have been saved."];
        if (!string.Equals(_form.Locale, System.Globalization.CultureInfo.CurrentUICulture.Name, StringComparison.OrdinalIgnoreCase) && SangamLanguages.IsOffered(_form.Locale))
        {
            // PR-18: show the portal in the language just chosen, straight away.
            Navigation.NavigateTo(LocalizationExtensions.SwitchUrl(_form.Locale, "/profile"), forceLoad: true);
            return;
        }

        await LoadAsync();
    }

    private async Task SaveModeAsync()
    {
        if (SignInModes.TryParse(_mode, out SignInMode mode))
        {
            await Accounts.SetSignInPreferenceAsync(_userId, mode);
            _message = L["Your sign-in preference has been saved."];
            await LoadAsync();
        }
    }

    private async Task DownloadAsync()
    {
        _working = true;
        string json = await Portal.ExportAsync(_userId, null);
        _working = false;
        await Js.InvokeVoidAsync("sangamDownload", $"sangam-data-{DateTimeOffset.UtcNow:yyyy-MM-dd}.json", json);
        _message = L["Your data has been downloaded."];
    }

    private async Task DeleteAsync()
    {
        _working = true;
        await Portal.RequestDeletionAsync(_userId, null);
        _working = false;
        _confirmingDelete = false;
        _message = L["Your account is scheduled for deletion. You have been signed out everywhere."];
        await LoadAsync();
    }

    private async Task CancelDeletionAsync()
    {
        _working = true;
        await Portal.CancelDeletionAsync(_userId, null);
        _working = false;
        _message = L["Your account is no longer scheduled for deletion."];
        await LoadAsync();
    }

    private async Task BeginMfaAsync()
    {
        _working = true;
        _mfaError = null;
        _recoveryCodes = [];
        _enrolment = await Mfa.BeginEnrolmentAsync(_userId);
        _working = false;
    }

    private async Task ConfirmMfaAsync()
    {
        _working = true;
        _mfaError = null;
        MfaConfirmation confirmation = await Mfa.ConfirmEnrolmentAsync(_userId, _mfaCode, null);
        _working = false;

        if (!confirmation.Succeeded)
        {
            _mfaError = L["That code is not correct. Authenticator codes change every 30 seconds — try the current one."];
            return;
        }

        _enrolment = null;
        _mfaCode = string.Empty;
        _recoveryCodes = confirmation.RecoveryCodes;
        _message = L["Two-step sign-in is on. You will be asked for a code next time you sign in."];
        await LoadAsync();
    }

    private async Task DisableMfaAsync()
    {
        _working = true;
        bool removed = await Mfa.DisableAsync(_userId, null);
        _working = false;
        _message = removed
            ? L["Your authenticator app has been removed."]
            : L["Two-step sign-in cannot be removed from an account with console access."];
        await LoadAsync();
    }

    private Task DownloadRecoveryAsync() =>
        Js.InvokeVoidAsync("sangamDownloadText", "sangam-recovery-codes.txt", string.Join(Environment.NewLine, _recoveryCodes)).AsTask();

    /// <summary>Splits a stored E.164 number back into the country and the national part.</summary>
    private static (string Iso, string National) SplitMobile(string? mobile)
    {
        if (string.IsNullOrEmpty(mobile) || mobile[0] != '+')
        {
            return (CountryCodes.DefaultIso, mobile ?? string.Empty);
        }

        CountryCode? match = CountryCodes.All
            .Where(c => mobile.StartsWith(c.DialCode, StringComparison.Ordinal))
            .Where(c => c.NationalDigits == 0 || mobile.Length - c.DialCode.Length == c.NationalDigits)
            .OrderByDescending(c => c.DialCode.Length)
            .FirstOrDefault();

        return match is null
            ? (CountryCodes.DefaultIso, mobile[1..])
            : (match.Iso, mobile[match.DialCode.Length..]);
    }

    private (string Text, bool Good)? Outcome(string code) => code switch
    {
        "verified" => (L["Your identity is verified with DigiLocker. Your name, date of birth and gender now match its record."], true),
        "removed" => (L["The DigiLocker verification is removed. You can change your name and gender again."], true),
        "taken" => (L["That DigiLocker account already verifies another Sangam account. One DigiLocker identity can verify one account only."], false),
        "denied" => (L["DigiLocker verification was cancelled. Nothing changed."], false),
        "failed" => (L["DigiLocker could not confirm your details just now. Nothing changed; please try again later."], false),
        "expired" => (L["The verification took too long, or was started in another window. Please start again."], false),
        "agree" => (L["Tick the box to agree before verifying with DigiLocker."], false),
        "off" => (L["Verification with DigiLocker is not available."], false),
        _ => null,
    };

    private sealed class ProfileForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your first name.")]
        [System.ComponentModel.DataAnnotations.StringLength(100)]
        public string FirstName { get; set; } = string.Empty;

        // Not required here: a one-word name verified through DigiLocker has no family name (the server checks the rest).
        [System.ComponentModel.DataAnnotations.StringLength(100)]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Locale { get; set; } = "en-IN";

        [System.ComponentModel.DataAnnotations.Required]
        public string Gender { get; set; } = "prefer_not_to_say";

        [System.ComponentModel.DataAnnotations.Required]
        public string CountryIso { get; set; } = CountryCodes.DefaultIso;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your mobile number.")]
        public string MobileNumber { get; set; } = string.Empty;
    }
}
