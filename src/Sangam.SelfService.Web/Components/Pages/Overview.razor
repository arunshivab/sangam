@page "/"
@inject IPortalService Portal
@inject IPortalRolesService Roles
@inject IAccountService Accounts
@inject IMfaService Mfa
@inject Sangam.Identity.Application.Passkeys.IPasskeyService Passkeys
@inject AuthenticationStateProvider AuthProvider
@inject IConfiguration Configuration

<PageTitle>@L["Overview · sangam"]</PageTitle>

<h1 class="sg-greeting">@L["Namaste, {0}", FirstName]</h1>
<p class="sg-subtitle">@L["This is your Sangam account. Everything an application can see about you, and everything you can take back, is here."]</p>

@if (_apps is null || _user is null)
{
  <p class="sg-note">@L["Loading…"]</p>
}
else
{
  @foreach (PortalRole ending in _endingSoon)
  {
    <p class="sg-banner sg-banner--info" role="status" data-panel="ending-soon">@L["Your {0} role in {1} ends on {2}. Only the organisation that gave it can extend it.", ending.RoleName, ending.AppName, IndiaTime.LongDate(ending.Until!.Value)]</p>
  }

  <div class="sg-overview">
    <section class="sg-panel" data-panel="your-apps">
      <h2 class="sg-panel-title">@L["Your apps"]</h2>
      @if (_apps.Count == 0)
      {
        <p class="sg-panel-body">@L["When you sign in to an application with your Sangam account, it appears here."]</p>
      }
      else
      {
        <ul class="sg-launch">
          @foreach (LinkedApp app in _apps.Where(a => a.ClientId != _portalClientId).Take(6))
          {
            <li class="sg-launch-tile">
              <span class="sg-app-tile" style="background:@app.BrandColour" aria-hidden="true">@app.Glyph</span>
              <span class="sg-app-text">
                <span class="sg-app-name">@app.DisplayName</span>
                <span class="sg-app-desc">@(app.Organisations.Count == 0 ? (app.Description ?? app.OwnerCompanyName) : app.Organisations.Count == 1 ? app.Organisations[0] : L["{0}, +{1} more", app.Organisations[0], app.Organisations.Count - 1])</span>
              </span>
              @if (SafeHome(app.HomepageUrl) is string home)
              {
                <a class="sg-launch-open" href="@home" rel="noopener">@L["Open →"]</a>
              }
            </li>
          }
        </ul>
        <a class="sg-tile-link" href="/apps">@L["See every app and what it can see →"]</a>
      }
    </section>

    <section class="sg-panel" data-panel="checkup">
      <h2 class="sg-panel-title">@L["Security checkup"]</h2>
      @if (_checkup.Count == 0)
      {
        <p class="sg-panel-body"><span class="sg-cord-dot sg-cord-dot--active" aria-hidden="true"></span>@L["Nothing to do. Your account is well protected."]</p>
      }
      else
      {
        <p class="sg-panel-body">@(_checkup.Count == 1 ? L["1 thing would make your account safer."] : L["{0} things would make your account safer.", _checkup.Count])</p>
        <ul class="sg-checkup">
          @foreach (CheckupItem item in _checkup)
          {
            <li>
              <span class="sg-cord-dot sg-cord-dot--expiring" aria-hidden="true"></span>
              <span class="sg-grow">@CheckupText(item)</span>
              <a href="@CheckupLink(item)">@L["Fix →"]</a>
            </li>
          }
        </ul>
      }
    </section>
  </div>
}

@code {
    private UserSummary? _user;
    private IReadOnlyList<LinkedApp>? _apps;
    private IReadOnlyList<CheckupItem> _checkup = [];
    private List<PortalRole> _endingSoon = [];
    private string _portalClientId = "sangam-portal";
    private string FirstName { get; set; } = "there";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        Guid? userId = PortalUser.Id(state.User);
        FirstName = PortalUser.Name(state.User).Split(' ')[0];
        _portalClientId = Configuration["Sangam:Portal:ClientId"] ?? "sangam-portal";
        if (userId is not Guid id)
        {
            return;
        }

        DateTimeOffset now = DateTimeOffset.UtcNow;
        _user = await Accounts.FindByIdAsync(id);
        _apps = await Portal.GetLinkedAppsAsync(id);
        bool authenticator = await Mfa.IsEnrolledAsync(id);
        int passkeys = Passkeys.Enabled ? (await Passkeys.ListAsync(id)).Count : 0;
        _checkup = _user is null ? [] : SecurityCheckup.For(_user, authenticator, passkeys, [.. _apps.Where(a => a.ClientId != _portalClientId)], now);
        // rc.10 (P1): a role ending in the next 30 days is said here, where the person will see it.
        _endingSoon = [.. (await Roles.GetAsync(id)).SelectMany(o => o.Roles).Where(r => r.Until is DateTimeOffset until && until - now <= TimeSpan.FromDays(30)).OrderBy(r => r.Until)];
    }

    /// <summary>Only an https address (http on this computer, in development) is offered as a link.</summary>
    private static string? SafeHome(string? url)
        => Uri.TryCreate(url, UriKind.Absolute, out Uri? uri) && (uri.Scheme == Uri.UriSchemeHttps || (uri.Scheme == Uri.UriSchemeHttp && uri.IsLoopback)) ? uri.AbsoluteUri : null;

    private string CheckupText(CheckupItem item) => item switch
    {
        CheckupItem.AddStrongMethod => L["Add an authenticator app or a passkey: stronger than a password and an emailed code."],
        CheckupItem.TwoStepEveryTime => L["A password alone signs you in. Turn on two-step sign-in every time."],
        CheckupItem.VerifyMobile => L["Verify your mobile number, so it can help you get back into your account."],
        CheckupItem.DormantApps => L["Apps you have not used for three months still have access."],
        _ => L["Verify with DigiLocker once more: Sangam changed a key that protects your verification."],
    };

    private string CheckupLink(CheckupItem item) => item switch
    {
        CheckupItem.VerifyMobile => (Configuration["Sangam:Authority"] ?? "https://id.sangamid.in").TrimEnd('/') + "/account/mobile",
        CheckupItem.DormantApps => "/apps",
        CheckupItem.Reverify => "/profile",
        _ => "/security",
    };
}
