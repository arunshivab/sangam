@page "/audit"
@inject IPortalService Portal
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Audit log · sangam</PageTitle>

<PageHeader Title="Audit log" Subtitle="Everything that has happened on your account, and who did it." />

<div class="sg-filters" role="group" aria-label="Time range">
  @foreach ((string label, int? days) in Ranges)
  {
    <button type="button" class="sg-filter @(_days == days ? "sg-filter--active" : "")" @onclick="() => SetRangeAsync(days)">@label</button>
  }
</div>

@if (_page is null)
{
  <p class="sg-note">Loading…</p>
}
else if (_page.Total == 0)
{
  <p class="sg-note">Nothing recorded in this period.</p>
}
else
{
  <ol class="sg-audit">
    @foreach (AuditLine line in _page.Lines)
    {
      <li class="sg-audit-row @(line.IsSecuritySensitive ? "sg-audit-row--flagged" : "")">
        <span class="sg-audit-when" title="@Relative.Full(line.OccurredAt)">@Relative.Describe(line.OccurredAt, _now)</span>
        <span class="sg-audit-what">
          <span class="sg-audit-summary">@line.Summary</span>
          <span class="sg-audit-meta">@line.Actor@(line.IpAddress is null ? "" : " · ")<span class="sg-mono">@line.IpAddress</span></span>
        </span>
      </li>
    }
  </ol>

  <div class="sg-pager">
    <button type="button" class="sg-btn sg-btn--secondary sg-btn--row" @onclick="() => GoAsync(_page.Page - 1)" disabled="@(_page.Page == 0)">Newer</button>
    <span class="sg-pager-label">Page @(_page.Page + 1) of @_page.PageCount · @_page.Total events</span>
    <button type="button" class="sg-btn sg-btn--secondary sg-btn--row" @onclick="() => GoAsync(_page.Page + 1)" disabled="@(_page.Page + 1 >= _page.PageCount)">Older</button>
  </div>
}

@code {
    private static readonly (string Label, int? Days)[] Ranges =
    [
        ("30 days", 30),
        ("90 days", 90),
        ("1 year", 365),
        ("Everything", null),
    ];

    private AuditPage? _page;
    private int? _days = 90;
    private Guid _userId;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = PortalUser.Id(state.User) ?? Guid.Empty;
        await GoAsync(0);
    }

    private async Task SetRangeAsync(int? days)
    {
        _days = days;
        await GoAsync(0);
    }

    private async Task GoAsync(int page)
    {
        _now = DateTimeOffset.UtcNow;
        DateTimeOffset? since = _days is int d ? _now.AddDays(-d) : null;
        _page = _userId == Guid.Empty ? new AuditPage([], 0, 0, 50) : await Portal.GetAuditAsync(_userId, since, page, 50);
    }
}
