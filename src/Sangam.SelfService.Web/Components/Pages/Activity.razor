@page "/activity"
@page "/audit"
@inject IPortalService Portal
@inject AuthenticationStateProvider AuthProvider

@* rc.10 (P5): Activity, filtered by kind; what someone else did is marked with an ochre rule. "/audit" stays for old links. *@
<PageTitle>@L["Activity · sangam"]</PageTitle>

<PageHeader Title="@L["Activity"].Value" Subtitle="@L["Everything that has happened on your account, and who did it."].Value" />

<div class="sg-filters" role="group" aria-label="@L["Show"]">
  @foreach ((string label, ActivityFilter filter) in Kinds)
  {
    <button type="button" class="sg-filter @(_filter == filter ? "sg-filter--active" : "")" aria-pressed="@(_filter == filter ? "true" : "false")" @onclick="() => SetKindAsync(filter)">@label</button>
  }
</div>
<div class="sg-filters sg-filters--range" role="group" aria-label="@L["Time range"]">
  @foreach ((string label, int? days) in Ranges)
  {
    <button type="button" class="sg-filter @(_days == days ? "sg-filter--active" : "")" aria-pressed="@(_days == days ? "true" : "false")" @onclick="() => SetRangeAsync(days)">@label</button>
  }
</div>

@if (_page is null)
{
  <p class="sg-note">@L["Loading…"]</p>
}
else if (_page.Total == 0)
{
  <p class="sg-note">@L["Nothing recorded in this period."]</p>
}
else
{
  <ol class="sg-audit">
    @foreach (AuditLine line in _page.Lines)
    {
      <li class="sg-audit-row @(ByOthers(line) ? "sg-audit-row--others" : "")">
        <span class="sg-audit-when" title="@Relative.Full(line.OccurredAt)">@Relative.Describe(line.OccurredAt, _now)</span>
        <span class="sg-audit-what">
          <span class="sg-audit-summary">@L[line.Summary]@if (line.IsSecuritySensitive) { <span class="sg-badge sg-badge--security">@L["Security"]</span> }</span>
          <span class="sg-audit-meta">@L[line.Actor]@(line.IpAddress is null ? "" : " · ")<span class="sg-mono">@line.IpAddress</span></span>
        </span>
      </li>
    }
  </ol>

  <div class="sg-pager">
    <button type="button" class="sg-btn sg-btn--secondary sg-btn--row" @onclick="() => GoAsync(_page.Page - 1)" disabled="@(_page.Page == 0)">@L["Newer"]</button>
    <span class="sg-pager-label">@L["Page {0} of {1} · {2} events", _page.Page + 1, _page.PageCount, _page.Total]</span>
    <button type="button" class="sg-btn sg-btn--secondary sg-btn--row" @onclick="() => GoAsync(_page.Page + 1)" disabled="@(_page.Page + 1 >= _page.PageCount)">@L["Older"]</button>
  </div>
}

@code {
    private (string Label, ActivityFilter Filter)[] Kinds =>
    [
        (L["All"], ActivityFilter.All),
        (L["Sign-ins"], ActivityFilter.SignIns),
        (L["Apps & permissions"], ActivityFilter.Apps),
        (L["Roles"], ActivityFilter.Roles),
        (L["Changed by someone else"], ActivityFilter.ByOthers),
    ];

    private (string Label, int? Days)[] Ranges =>
    [
        (L["30 days"], 30),
        (L["90 days"], 90),
        (L["1 year"], 365),
        (L["Everything"], null),
    ];

    // The narrator's actor for the person themselves; anything else was done by someone else (rc.10, P5).
    private static bool ByOthers(AuditLine line) => line.Actor != "You"; // i18n-ignore: the narrator's code, never shown

    private AuditPage? _page;
    private int? _days = 90;
    private ActivityFilter _filter = ActivityFilter.All;
    private Guid _userId;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = PortalUser.Id(state.User) ?? Guid.Empty;
        await GoAsync(0);
    }

    private async Task SetRangeAsync(int? days)
    {
        _days = days;
        await GoAsync(0);
    }

    private async Task SetKindAsync(ActivityFilter filter)
    {
        _filter = filter;
        await GoAsync(0);
    }

    private async Task GoAsync(int page)
    {
        _now = DateTimeOffset.UtcNow;
        DateTimeOffset? since = _days is int d ? _now.AddDays(-d) : null;
        _page = _userId == Guid.Empty ? new AuditPage([], 0, 0, 50) : await Portal.GetActivityAsync(_userId, since, _filter, page, 50);
    }
}
