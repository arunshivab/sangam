@inherits LayoutComponentBase

<header class="sg-topbar">
  <a class="sg-topbar-brand" href="/" aria-label="@L["Sangam account home"]">
    <SangamLockup MarkSize="24" />
  </a>
  @* rc.10 (P-shell): one tab per job, in the order people need them. *@
  <nav class="sg-tabs" aria-label="@L["Account sections"]">
    <NavLink class="sg-tab" ActiveClass="sg-tab--active" href="/" Match="NavLinkMatch.All">@L["Overview"]</NavLink>
    <NavLink class="sg-tab" ActiveClass="sg-tab--active" href="/apps">@L["Apps"]</NavLink>
    <NavLink class="sg-tab" ActiveClass="sg-tab--active" href="/security">@L["Sign-in & security"]</NavLink>
    <NavLink class="sg-tab" ActiveClass="sg-tab--active" href="/roles">@L["Organisations & roles"]</NavLink>
    <NavLink class="sg-tab" ActiveClass="sg-tab--active" href="/activity">@L["Activity"]</NavLink>
    <NavLink class="sg-tab" ActiveClass="sg-tab--active" href="/profile">@L["Profile & data"]</NavLink>
  </nav>
  <div class="sg-topbar-user">
    <AuthorizeView>
      <Authorized>
        <span class="sg-topbar-name">@PortalUser.Name(context.User)</span>
        <span class="sg-avatar sg-avatar--initials" aria-hidden="true">@PortalUser.Initials(context.User)</span>
        <a class="sg-topbar-signout" href="/signout">@L["Sign out"]</a>
      </Authorized>
    </AuthorizeView>
  </div>
</header>

<main class="sg-portal">
  @Body
</main>
<footer class="sg-lang-footer"><LanguagePicker /></footer>
