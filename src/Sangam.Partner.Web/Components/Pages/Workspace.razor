@page "/apps/{AppId:guid}"
@page "/apps/{AppId:guid}/{Tab}"

@if (_info is null)
{
  <PageTitle>@L["Not available · Sangam partners"]</PageTitle>
  <h1 class="sg-h1">@L["Not available"]</h1>
  <p class="sg-lede">@L["You do not administer that application."] <a href="/">@L["Back to your applications"]</a>.</p>
}
else
{
  <PageTitle>@_info.AppName · Sangam partners</PageTitle>
  <h1 class="sg-h1">@_info.AppName · @SectionName</h1>

  @switch (CurrentTab)
  {
    case "roles":
      <RolesTab Info="_info" />
      break;
    case "admins" when _info.IsOwner:
      <AdminsTab Info="_info" />
      break;
    case "people":
    case "admins":
      <OrganisationsTab Info="_info" />
      break;
    case "settings":
      <SettingsTab Info="_info" />
      break;
    case "webhooks":
      <WebhooksTab Info="_info" />
      break;
    case "attributes":
      <AttributesTab Info="_info" />
      break;
    case "provisioning":
      <ProvisioningTab Info="_info" />
      break;
    case "evidence":
      <EvidenceTab Info="_info" />
      break;
    case "messages":
      <p class="sg-lede">@L["The e-mails Sangam sends for {0}: sign-in and verification codes, password resets and invitations. Security notices stay Sangam's own.", _info.AppName]</p>
      <TemplateEditor UserId="_info.UserId" Scope="CustomisationScope.App" ScopeId="_info.AppId" Heading="@L["Messages"].Value" PreviewHeading="@_info.AppName" Key="app-templates" />
      break;
    default:
      <OverviewTab Info="_info" />
      break;
  }
}

@code {
    /// <summary>The application.</summary>
    [Parameter]
    public Guid AppId { get; set; }

    /// <summary>The section; the application's overview when absent (rc.10).</summary>
    [Parameter]
    public string? Tab { get; set; }

    /// <summary>The signed-in administrator.</summary>
    [CascadingParameter]
    public PartnerContext? Context { get; set; }

    private WorkspaceInfo? _info;

    private string CurrentTab => Tab ?? "overview";

    // rc.10: the sections are in the sidebar; the heading names the one open.
    private string SectionName => CurrentTab switch
    {
        "people" => L["Organisations & people"],
        "admins" when _info?.IsOwner == true => L["Administrators"],
        "admins" => L["Organisations & people"],
        "roles" => L["Roles"],
        "settings" => L["Sign-in rules & branding"],
        "messages" => L["Messages"],
        "attributes" => L["Attributes & claims"],
        "provisioning" => L["Provisioning"],
        "webhooks" => L["Webhooks"],
        "evidence" => L["Compliance evidence"],
        _ => L["Overview"],
    };

    protected override void OnParametersSet()
    {
        // Only what the gate read on this visit. The service re-checks the rank on every call too,
        // so a stale page cannot act on an application its user no longer administers.
        PartnerAppRow? app = Context?.Apps.FirstOrDefault(a => a.AppId == AppId);
        _info = app is null ? null : new WorkspaceInfo(Context!.UserId, app.AppId, app.DisplayName, app.Role);
    }
}
