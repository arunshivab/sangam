@page "/"
@inject IPartnerService Partners
@inject NavigationManager Nav

<PageTitle>@L["Your applications · Sangam partners"]</PageTitle>

<h1 class="sg-h1">@L["Your applications"]</h1>
<p class="sg-lede">@L["The applications on Sangam you help run. Everything you change here is recorded in your name, and people see in their own Sangam Activity when their roles change."]</p>

@if (Context is not null)
{
  @* rc.10 (R1): an application that needs action comes first. *@
  <ul class="sg-tiles" data-panel="apps">
    @foreach (PartnerAppRow app in Ordered)
    {
      PartnerAppOverview? o = _overviews.GetValueOrDefault(app.AppId);
      <li>
        <a class="sg-tile" href="@($"/apps/{app.AppId:D}")">
          <span class="sg-tile-head">
            <span class="sg-tile-glyph" style="background:@app.BrandColour" aria-hidden="true">@app.Glyph</span>
            <span class="sg-tile-text">
              <span class="sg-name">@app.DisplayName</span>
              <span class="sg-sub">@(app.Role == AppAdminRole.Owner ? L["Owner"] : L["Administrator"])</span>
            </span>
          </span>
          @if (o is not null)
          {
            <ul class="sg-tile-lines">
              @if (app.Status != AppStatus.Active)
              {
                <li><span class="sg-dot sg-dot--danger" aria-hidden="true"></span>@L["Disabled by Sangam: nobody can sign in"]</li>
              }
              <li><span class="sg-dot" aria-hidden="true"></span>@L["{0} people · {1} organisations", o.People, o.Organisations]</li>
              @if (o.ProvisioningFailing || o.WebhooksFailing > 0)
              {
                <li><span class="sg-dot sg-dot--danger" aria-hidden="true"></span>@L["An integration is failing"]</li>
              }
              else
              {
                <li><span class="sg-dot sg-dot--ok" aria-hidden="true"></span>@L["{0} used it in the last 24 hours", o.SignIns24h]</li>
              }
              @if (o.SecretIsOld(DateTimeOffset.UtcNow))
              {
                <li><span class="sg-dot sg-dot--warn" aria-hidden="true"></span>@L["Client secret over a year old"]</li>
              }
            </ul>
          }
        </a>
      </li>
    }
  </ul>

  @* rc.12: the organisations this person administers themselves, in the organisation console. *@
  @if (Context.OwnScopes.Any())
  {
    <h2 class="sg-h2 sg-h2--section">@L["Your organisations"]</h2>
    <ul class="sg-tiles" data-panel="org-scopes">
      @foreach (OrgScope scope in Context.OwnScopes)
      {
        <li>
          <a class="sg-tile" href="@($"/org/{scope.OrgId:D}")">
            <span class="sg-tile-head">
              <span class="sg-tile-glyph" style="background:@scope.BrandColour" aria-hidden="true">@scope.Glyph</span>
              <span class="sg-tile-text"><span class="sg-name">@scope.OrgName</span><span class="sg-sub">@scope.AppName</span></span>
            </span>
          </a>
        </li>
      }
    </ul>
  }
}

@code {
    /// <summary>The signed-in administrator.</summary>
    [CascadingParameter]
    public PartnerContext? Context { get; set; }

    private readonly Dictionary<Guid, PartnerAppOverview> _overviews = [];

    private IEnumerable<PartnerAppRow> Ordered => (Context?.Apps ?? [])
        .OrderBy(a => _overviews.TryGetValue(a.AppId, out PartnerAppOverview? o) && o.NeedsAction(DateTimeOffset.UtcNow) ? 0 : 1)
        .ThenBy(a => a.DisplayName, StringComparer.CurrentCulture);

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (Context is null)
        {
            return;
        }

        // rc.12: a customer or branch admin who runs no application starts in the organisation console.
        if (Context.Apps.Count == 0)
        {
            Nav.NavigateTo("/org", replace: true);
            return;
        }

        foreach (PartnerAppRow app in Context.Apps)
        {
            if (await Partners.GetOverviewAsync(Context.UserId, app.AppId) is PartnerAppOverview overview)
            {
                _overviews[app.AppId] = overview;
            }
        }
    }
}
