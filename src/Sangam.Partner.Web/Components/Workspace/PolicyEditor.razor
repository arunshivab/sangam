@* PR-16: one level's security policy (an application, or an organisation), shown against what it inherits. *@

<p class="sg-muted">@Explanation</p>

@if (ShowSignIn)
{
  <fieldset class="sg-choices">
    <legend class="sg-label">@L["Sign-in rule"]</legend>
    <label class="sg-check">
      <input type="radio" name="@($"{Key}-signin")" checked="@(_signIn is null)" @onchange="() => _signIn = null" />
      @L["Follow {0}", InheritLabel] <span class="sg-muted">— @SignInName(View.Inherited.SignIn)</span>
    </label>
    @if (SecurityRank(View.Inherited.SignIn) <= 2)
    {
      <label class="sg-check">
        <input type="radio" name="@($"{Key}-signin")" checked="@(_signIn == SignInPolicy.PasswordAndOtp)" @onchange="() => _signIn = SignInPolicy.PasswordAndOtp" />
        @L["Always two-step"] <span class="sg-muted">@L["— password, then a code"]</span>
      </label>
    }
    <label class="sg-check">
      <input type="radio" name="@($"{Key}-signin")" checked="@(_signIn == SignInPolicy.PasskeyOnly)" @onchange="() => _signIn = SignInPolicy.PasskeyOnly" />
      @L["Passkey only"] <span class="sg-muted">@L["— fingerprint, face or device PIN; no password"]</span>
    </label>
  </fieldset>
}

<div class="sg-form-row">
  <label class="sg-label" for="@($"{Key}-minlen")">@L["Shortest password allowed"]</label>
  <input id="@($"{Key}-minlen")" class="sg-input sg-input--short" type="number" min="@View.Inherited.MinPasswordLength" max="64" placeholder="@View.Inherited.MinPasswordLength"
         value="@_minLength" @onchange="e => _minLength = int.TryParse(e.Value?.ToString(), out int n) ? n : null" />
  <span class="sg-muted">@L["characters — leave empty to follow {0} ({1}). People whose password is shorter choose a new one at their next sign-in.", InheritLabel, View.Inherited.MinPasswordLength]</span>
</div>

<fieldset class="sg-choices">
  <legend class="sg-label">@L["Second factor (an authenticator app or a passkey)"]</legend>
  @foreach (MfaRequirement option in Enum.GetValues<MfaRequirement>())
  {
    @if (option >= View.Inherited.Mfa)
    {
      MfaRequirement? value = option == View.Inherited.Mfa ? null : option;
      <label class="sg-check">
        <input type="radio" name="@($"{Key}-mfa")" checked="@(_mfa == value)" @onchange="() => _mfa = value" />
        <span>@MfaName(option)@if (value is null) { <span class="sg-muted"> — @L["as {0}", InheritLabel]</span> }</span>
      </label>
    }
  }
</fieldset>

<label class="sg-check">
  <input type="checkbox" checked="@(_breach == true || View.Inherited.BreachedPasswordCheck)" disabled="@(View.Inherited.BreachedPasswordCheck || !View.BreachCheckAvailable)"
         @onchange="e => _breach = e.Value is true ? true : null" />
  <span>
    @L["Refuse passwords found in known data breaches"]
    @if (View.Inherited.BreachedPasswordCheck)
    {
      <span class="sg-muted">— @L["already required by {0}", InheritLabel]</span>
    }
    else if (!View.BreachCheckAvailable)
    {
      <span class="sg-muted">@L["— not yet switched on for Sangam (the Sangam team's decision)"]</span>
    }
  </span>
</label>

@* rc.5: an organisation or application may keep a character-type rule it already follows; never the default (ASVS V2.1.9). *@
<label class="sg-check">
  <input type="checkbox" checked="@(_types == true || View.Inherited.RequireCharacterTypes)" disabled="@View.Inherited.RequireCharacterTypes"
         @onchange="e => _types = e.Value is true ? true : null" />
  <span>
    @L["Require an upper-case letter, a lower-case letter, a number and a symbol"]
    @if (View.Inherited.RequireCharacterTypes)
    {
      <span class="sg-muted">— @L["already required by {0}", InheritLabel]</span>
    }
  </span>
</label>
@if (_types == true && !View.Inherited.RequireCharacterTypes)
{
  <p class="sg-notice sg-notice--warn" role="status" data-notice="character-types">
    @L["Not recommended. Security standards (OWASP ASVS and NIST) advise against character-type rules: people answer them with predictable passwords such as Pune@2026. Length and the breached-password check protect better. Turn this on only to keep a policy your organisation already follows. Everyone it covers must meet it when they next set a password, in every application they use with Sangam."]
  </p>
}

<div class="sg-actions">
  <button type="button" class="sg-btn sg-btn--primary" @onclick="SaveAsync" disabled="@Busy">@L["Save security policy"]</button>
</div>

@code {
    /// <summary>The policy being edited.</summary>
    [Parameter]
    [EditorRequired]
    public PolicyView View { get; set; } = null!;

    /// <summary>A prefix for element ids, unique on the page.</summary>
    [Parameter]
    public string Key { get; set; } = "policy";

    /// <summary>Whether the sign-in rule is edited here (organisations); an application's is edited with its settings.</summary>
    [Parameter]
    public bool ShowSignIn { get; set; }

    /// <summary>How the level above is named in the labels, already in the reader's language, for example "the application".</summary>
    [Parameter]
    public string InheritLabel { get; set; } = "Sangam";

    /// <summary>The sentence above the editor.</summary>
    [Parameter]
    public string Explanation { get; set; } = string.Empty;

    /// <summary>Whether a save is in progress.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Called with the settings to save.</summary>
    [Parameter]
    public EventCallback<PolicyInput> OnSave { get; set; }

    private SignInPolicy? _signIn;
    private int? _minLength;
    private MfaRequirement? _mfa;
    private bool? _breach;
    private bool? _types;

    protected override void OnParametersSet()
    {
        _signIn = ShowSignIn ? View.SignIn : null;
        _minLength = View.MinPasswordLength;
        _mfa = View.Mfa is MfaRequirement m && m > View.Inherited.Mfa ? m : null;
        _breach = View.BreachedPasswordCheck == true ? true : null;
        _types = View.RequireCharacterTypes == true ? true : null;
    }

    private Task SaveAsync() => OnSave.InvokeAsync(new PolicyInput(_signIn, _minLength, _mfa, _breach, _types));

    private static int SecurityRank(SignInPolicy policy) => Sangam.Identity.Domain.SecurityPolicy.Rank(policy);

    private string SignInName(SignInPolicy policy) => policy switch
    {
        SignInPolicy.Password => L["password only"],
        SignInPolicy.OtpOnly => L["an e-mailed code, no password"],
        SignInPolicy.PasswordAndOtp => L["always two-step"],
        SignInPolicy.PasskeyOnly => L["passkey only"],
        _ => L["each person's own choice"],
    };

    private string MfaName(MfaRequirement mfa) => mfa switch
    {
        MfaRequirement.Required => L["Required for everyone"],
        MfaRequirement.RequiredForAdministrators => L["Required for this application's administrators"],
        _ => L["Each person decides"],
    };
}
