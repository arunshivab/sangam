@using Sangam.Identity.Domain.Entities
@inject IPartnerService Partners
@inject IConfiguration Configuration
@inject IJSRuntime Js
@inject IClientSecretService Secrets

@* rc.15 (ASVS V2.10.1): and its public keys, for signing in with a key instead of a secret (private_key_jwt).
   rc.11 (R5): what the application's developers need to connect. The client id, issuer and discovery address are not
   secrets. Two client secrets can be live, so an owner rotates without a break; a secret is shown once, when it is made,
   and only its hint after that. Addresses are changed by the Sangam team on request. *@
@if (_credentials is null)
{
  <p class="sg-muted">@L["Loading…"]</p>
}
else
{
  <p class="sg-lede">@L["What your developers need to connect {0} to Sangam. Addresses are changed by the Sangam team on request.", Info.AppName]</p>

  <section class="sg-panel" data-panel="client">
    <h2 class="sg-label-mono">@L["Client"]</h2>
    <dl class="sg-copy-list">
      @foreach ((string label, string value, string key) in Rows)
      {
        <div class="sg-copy-row">
          <dt>@label</dt>
          <dd class="sg-mono">@value</dd>
          <dd><button type="button" class="sg-btn sg-btn--secondary sg-btn--row" @onclick="() => CopyAsync(key, value)">@(_copied == key ? L["Copied"] : L["Copy"])</button></dd>
        </div>
      }
    </dl>
  </section>

  <section class="sg-panel" data-panel="secrets">
    <h2 class="sg-label-mono">@L["Client secrets"]</h2>
    @if (_secrets is null || !_secrets.Confidential)
    {
      <p class="sg-muted">@L["None: {0} signs in as a public client, with PKCE and no secret.", Info.AppName]</p>
    }
    else
    {
      <p class="sg-muted">@L["Two secrets can be live at once, so you can change it without a break: make a new one, move your servers to it, then revoke the old one. Each secret you make works for twelve months."]</p>

      @if (_fresh is not null)
      {
        <div class="sg-fresh-secret" role="status" data-panel="new-secret">
          <p><strong>@L["Copy it now: it is not shown again."]</strong></p>
          <div class="sg-copy-row">
            <code class="sg-mono" data-secret>@_fresh</code>
            <button type="button" class="sg-btn sg-btn--secondary sg-btn--row" @onclick="@(() => CopyAsync("fresh", _fresh))">@(_copied == "fresh" ? L["Copied"] : L["Copy"])</button>
          </div>
          <div class="sg-actions">
            <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _fresh = null">@L["I have saved it"]</button>
          </div>
        </div>
      }

      <div class="sg-table-wrap" tabindex="0" role="region" aria-label="@L["Client secrets"]">
        <table class="sg-table sg-table--cards">
          <thead><tr><th>@L["Secret"]</th><th>@L["Made"]</th><th>@L["Expires"]</th><th>@L["Last used"]</th><th></th></tr></thead>
          <tbody>
            @if (_secrets.Issued is IssuedSecretRow issued)
            {
              <tr data-secret-row="issued">
                <td data-label="@L["Secret"]"><span class="sg-name">@L["Issued by Sangam"]</span><span class="sg-sub">@L["Set in Sangam's configuration"]</span></td>
                <td data-label="@L["Made"]">@(issued.SetAt is DateTimeOffset set ? IndiaTime.Date(set) : L["date not recorded"])</td>
                <td data-label="@L["Expires"]">
                  @if (issued.SetAt is DateTimeOffset age && DateTimeOffset.UtcNow - age > TimeSpan.FromDays(365))
                  {
                    <span class="sg-warn-text">@L["Over a year old: replace it"]</span>
                  }
                  else
                  {
                    <span class="sg-muted">@L["Until you revoke it"]</span>
                  }
                </td>
                <td data-label="@L["Last used"]"><span class="sg-muted">@L["Not recorded"]</span></td>
                <td>
                  @if (CanRevoke)
                  {
                    <button type="button" class="sg-btn sg-btn--warn sg-btn--row" @onclick="@(() => StartRevoke(null, L["the secret issued by Sangam"]))" disabled="@_busy">@L["Revoke"]</button>
                  }
                </td>
              </tr>
            }
            @foreach (ClientSecretRow row in _secrets.Owned)
            {
              <tr data-secret-row="@row.Id">
                <td data-label="@L["Secret"]"><span class="sg-name sg-mono">@row.Hint</span><span class="sg-sub">@L["Made by {0}", row.CreatedBy]</span></td>
                <td data-label="@L["Made"]">@IndiaTime.Date(row.CreatedAt)</td>
                <td data-label="@L["Expires"]">
                  @IndiaTime.Date(row.ExpiresAt)
                  @if (row.ExpiresAt - DateTimeOffset.UtcNow < ClientSecret.Warning)
                  {
                    <span class="sg-warn-text">@L["Soon: make a new one"]</span>
                  }
                </td>
                <td data-label="@L["Last used"]">@(row.LastUsedAt is DateTimeOffset used ? IndiaTime.Date(used) : L["Not yet"])</td>
                <td>
                  @if (CanRevoke)
                  {
                    <button type="button" class="sg-btn sg-btn--warn sg-btn--row" @onclick="@(() => StartRevoke(row.Id, row.Hint))" disabled="@_busy">@L["Revoke"]</button>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>

      @if (_revoking is not null)
      {
        <div class="sg-confirm" data-panel="revoke-secret">
          <p><strong>@L["Revoke {0}?", _revoking.Value.Name]</strong> @L["Anything still using it can no longer get tokens. Move your servers to another secret or a key first."]</p>
          <div class="sg-actions">
            <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _revoking = null">@L["Cancel"]</button>
            <button type="button" class="sg-btn sg-btn--danger" @onclick="RevokeAsync" disabled="@_busy">@L["Revoke"]</button>
          </div>
        </div>
      }

      @if (_secrets.CanManage)
      {
        <div class="sg-actions">
          <button type="button" class="sg-btn sg-btn--primary" @onclick="CreateAsync" disabled="@(_busy || _secrets.LiveCount >= ClientSecret.MaxLive)">@L["Make a new secret"]</button>
        </div>
        @if (_secrets.LiveCount >= ClientSecret.MaxLive)
        {
          <p class="sg-muted">@L["Two secrets are live. Revoke the one your servers no longer use before making another."]</p>
        }
      }
      else
      {
        <p class="sg-muted">@L["Only an owner of {0} can make or revoke secrets.", Info.AppName]</p>
      }
    }
  </section>

  @if (_secrets is { Confidential: true })
  {
    <section class="sg-panel" data-panel="keys">
      <h2 class="sg-label-mono">@L["Keys"]</h2>
      <p class="sg-muted">@L["Stronger than a secret: your servers keep a private key and sign a short-lived assertion with it (private_key_jwt); Sangam keeps only the public key. Once a key works, you can revoke your secrets. Two keys can be live, so you can change keys without a break."]</p>
      <p class="sg-muted">@L["Each assertion: iss and sub are your client ID, aud is Sangam's issuer exactly, a unique jti, and it expires within five minutes. Put the key ID in the header as kid. Sangam's SDKs do this for you."]</p>

      @if (_secrets.Keys.Count > 0)
      {
        <div class="sg-table-wrap" tabindex="0" role="region" aria-label="@L["Keys"]">
          <table class="sg-table sg-table--cards">
            <thead><tr><th>@L["Key"]</th><th>@L["Key ID"]</th><th>@L["Added"]</th><th>@L["Last used"]</th><th></th></tr></thead>
            <tbody>
              @foreach (ClientKeyRow key in _secrets.Keys)
              {
                <tr data-key-row="@key.Id">
                  <td data-label="@L["Key"]"><span class="sg-name">@key.Name</span><span class="sg-sub">@key.Kind · @L["Added by {0}", key.CreatedBy]</span></td>
                  <td data-label="@L["Key ID"]"><code class="sg-mono sg-pre">@key.KeyId</code></td>
                  <td data-label="@L["Added"]">@IndiaTime.Date(key.CreatedAt)</td>
                  <td data-label="@L["Last used"]">@(key.LastUsedAt is DateTimeOffset used ? IndiaTime.Date(used) : L["Not yet"])</td>
                  <td>
                    @if (CanRevoke)
                    {
                      <button type="button" class="sg-btn sg-btn--warn sg-btn--row" @onclick="@(() => _removingKey = key)" disabled="@_busy">@L["Remove"]</button>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      else
      {
        <p class="sg-muted">@L["No keys yet."]</p>
      }

      @if (_removingKey is not null)
      {
        <div class="sg-confirm" data-panel="remove-key">
          <p><strong>@L["Remove {0}?", _removingKey.Name]</strong> @L["Anything still signing with it can no longer get tokens. Move your servers to another key or a secret first."]</p>
          <div class="sg-actions">
            <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _removingKey = null">@L["Cancel"]</button>
            <button type="button" class="sg-btn sg-btn--danger" @onclick="RemoveKeyAsync" disabled="@_busy">@L["Remove"]</button>
          </div>
        </div>
      }

      @if (_secrets.CanManage)
      {
        @if (_secrets.Keys.Count < ClientKey.MaxLive)
        {
          <div class="sg-form-row">
            <label class="sg-label" for="key-name">@L["Name (optional)"]</label>
            <input id="key-name" class="sg-input" maxlength="80" @bind="_keyName" />
          </div>
          <div class="sg-form-row">
            <label class="sg-label" for="key-pem">@L["Public key (PEM or JSON Web Key)"]</label>
            <textarea id="key-pem" class="sg-input sg-mono" rows="6" spellcheck="false" maxlength="8000" @bind="_keyText" placeholder="-----BEGIN PUBLIC KEY-----"></textarea>
            <p class="sg-muted">@L["RSA of at least 2048 bits, or elliptic curve P-256, P-384 or P-521. Never paste a private key."]</p>
          </div>
          <div class="sg-actions">
            <button type="button" class="sg-btn sg-btn--primary" @onclick="AddKeyAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_keyText))">@L["Add key"]</button>
          </div>
        }
        else
        {
          <p class="sg-muted">@L["Two keys are live. Remove the one your servers no longer use before adding another."]</p>
        }
      }
      else
      {
        <p class="sg-muted">@L["Only an owner of {0} can add or remove keys.", Info.AppName]</p>
      }
    </section>
  }

  <StatusLine Ok="_ok" Message="@_message" />

  <section class="sg-panel" data-panel="redirects">
    <h2 class="sg-label-mono">@L["Redirect addresses"]</h2>
    @if (_credentials.RedirectUris.Count == 0)
    {
      <p class="sg-muted">@L["None registered."]</p>
    }
    <ul class="sg-uri-list">
      @foreach (string uri in _credentials.RedirectUris)
      {
        <li class="sg-mono">@uri</li>
      }
    </ul>
    @if (_credentials.PostLogoutRedirectUris.Count > 0)
    {
      <h3 class="sg-label-mono">@L["After sign-out"]</h3>
      <ul class="sg-uri-list">
        @foreach (string uri in _credentials.PostLogoutRedirectUris)
        {
          <li class="sg-mono">@uri</li>
        }
      </ul>
    }
    <a class="sg-btn sg-btn--secondary" href="@AskUrl">@L["Ask Sangam to add an address"]</a>
  </section>
}

@code {
    /// <summary>The application being worked on.</summary>
    [Parameter]
    [EditorRequired]
    public WorkspaceInfo Info { get; set; } = null!;

    private PartnerCredentials? _credentials;
    private string? _copied;

    private string Issuer => (Configuration["Sangam:Authority"] ?? "https://id.sangamid.in").TrimEnd('/');

    private IEnumerable<(string Label, string Value, string Key)> Rows =>
    [
        (L["Client ID"], _credentials!.ClientId, "client"),
        (L["Issuer"], Issuer, "issuer"),
        (L["Discovery"], Issuer + "/.well-known/openid-configuration", "discovery"),
    ];

    private string AskUrl => "mailto:help@sangamid.in?subject=" + Uri.EscapeDataString("Redirect address for " + _credentials!.ClientId); // i18n-ignore

    private ClientSecretsView? _secrets;
    private string? _fresh;
    private (Guid? Id, string Name)? _revoking;
    private bool _busy;
    private bool _ok;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _credentials = await Partners.GetCredentialsAsync(Info.UserId, Info.AppId);
        _secrets = await Secrets.GetAsync(Info.UserId, Info.AppId);
    }

    // The last way in (secret or key) cannot be removed, so the buttons show only while there are two or more.
    private bool CanRevoke => _secrets is { CanManage: true, CredentialCount: > 1 };

    private ClientKeyRow? _removingKey;
    private string? _keyName;
    private string? _keyText;

    private async Task AddKeyAsync()
    {
        _busy = true;
        _revoking = null;
        _removingKey = null;
        PartnerResult result = await Secrets.AddKeyAsync(Info.UserId, Info.AppId, _keyText ?? string.Empty, _keyName);
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _keyText = null;
            _keyName = null;
        }

        _secrets = await Secrets.GetAsync(Info.UserId, Info.AppId);
        _busy = false;
    }

    private async Task RemoveKeyAsync()
    {
        if (_removingKey is null)
        {
            return;
        }

        _busy = true;
        PartnerResult result = await Secrets.RemoveKeyAsync(Info.UserId, Info.AppId, _removingKey.Id);
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        _removingKey = null;
        _secrets = await Secrets.GetAsync(Info.UserId, Info.AppId);
        _busy = false;
    }

    private void StartRevoke(Guid? id, string name) => _revoking = (id, name);

    private async Task CreateAsync()
    {
        _busy = true;
        _revoking = null;
        NewClientSecret made = await Secrets.CreateAsync(Info.UserId, Info.AppId);
        _ok = made.Succeeded;
        _message = L[made.Message];
        _fresh = made.Secret;
        _copied = null;
        _secrets = await Secrets.GetAsync(Info.UserId, Info.AppId);
        _busy = false;
    }

    private async Task RevokeAsync()
    {
        if (_revoking is null)
        {
            return;
        }

        _busy = true;
        PartnerResult result = await Secrets.RevokeAsync(Info.UserId, Info.AppId, _revoking.Value.Id);
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        _revoking = null;
        _secrets = await Secrets.GetAsync(Info.UserId, Info.AppId);
        _busy = false;
    }

    private async Task CopyAsync(string key, string value)
    {
        _copied = await Js.InvokeAsync<bool>("sangamCopy", value) ? key : null;
    }
}
