@inject IPartnerService Partners

@* rc.10 (R2): how the application stands — the go-live checklist, then the last 24 hours of its integration. *@
@if (_overview is null)
{
  <p class="sg-muted">@L["Loading…"]</p>
}
else
{
  <p class="sg-lede">@L["How {0} stands: what is left before people rely on it, and how its integration with Sangam has run in the last 24 hours.", Info.AppName]</p>
  <div class="sg-grid">
    <section class="sg-panel" data-panel="go-live">
      <h2 class="sg-h2">@L["Go-live checklist"]</h2>
      <ul class="sg-checklist">
        <Check Done="_overview.Roles > 0" Text="@L["Roles are defined"]" Hint="@L["Your application's own words for what people may do."]" Link="@Link("roles")" />
        <Check Done="_overview.Organisations > 0" Text="@L["An organisation is registered"]" Hint="@L["The hospitals or clinics that use it, so roles have somewhere to be held."]" Link="@Link("people")" />
        <Check Done="_overview.People > 0" Text="@L["Someone has signed in through it"]" Hint="@L["The first person to link the application with their Sangam account."]" Link="@Link("people")" />
        <Check Done="_overview.Administrators >= 2" Text="@L["More than one administrator"]" Hint="@L["So nobody is the only person who can manage it."]" Link="@(Info.IsOwner ? Link("admins") : null)" />
        <Check Done="_overview.LogoutConfigured" Text="@L["Sangam knows where to end sessions"]" Hint="@L["Where Sangam tells the application that someone signed out. Sangam's team sets it: ask them."]" Link="@null" />
      </ul>
    </section>

    <section class="sg-panel" data-panel="health">
      <h2 class="sg-h2">@L["Integration health"]</h2>
      <dl class="sg-facts">
        <div><dt>@L["Used by"]</dt><dd>@L["{0} people in the last 24 hours", _overview.SignIns24h]</dd></div>
        <div>
          <dt>@L["Provisioning"]</dt>
          <dd>
            @if (!_overview.ProvisioningOn)
            {
              <span class="sg-muted">@L["Off"]</span>
            }
            else if (_overview.ProvisioningFailing)
            {
              <span class="sg-danger-text">@L["Failing"]</span>
            }
            else
            {
              @(_overview.ProvisioningLastSuccess is DateTimeOffset last ? L["Working · last sent {0}", IndiaTime.Stamp(last)] : L["Working"])
            }
          </dd>
        </div>
        <div>
          <dt>@L["Webhooks"]</dt>
          <dd>
            @if (_overview.Webhooks == 0)
            {
              <span class="sg-muted">@L["None"]</span>
            }
            else if (_overview.WebhooksFailing > 0)
            {
              <span class="sg-danger-text">@L["{0} of {1} endpoints failing", _overview.WebhooksFailing, _overview.Webhooks]</span>
            }
            else
            {
              @L["{0} endpoints working", _overview.Webhooks]
            }
            @if (_overview.DeliveriesWaiting > 0)
            {
              <span class="sg-sub">@L["{0} deliveries waiting", _overview.DeliveriesWaiting]</span>
            }
          </dd>
        </div>
        <div>
          <dt>@L["Client secret"]</dt>
          <dd>
            @if (_overview.HasSecret == false)
            {
              @L["None (public client)"]
            }
            else if (_overview.SecretSetAt is not DateTimeOffset set)
            {
              <span class="sg-muted">@L["Date not recorded"]</span>
            }
            else if (_overview.SecretIsOld(DateTimeOffset.UtcNow))
            {
              <span class="sg-warn-text">@L["Over a year old · ask Sangam's team to change it (set {0})", IndiaTime.Date(set)]</span>
            }
            else
            {
              @L["Set on {0}", IndiaTime.Date(set)]
            }
          </dd>
        </div>
        <div><dt>@L["Status"]</dt><dd>@(_overview.Status == AppStatus.Active ? L["Enabled"] : L["Disabled by Sangam: nobody can sign in"])</dd></div>
      </dl>
    </section>
  </div>
}

@code {
    /// <summary>The application.</summary>
    [Parameter]
    [EditorRequired]
    public WorkspaceInfo Info { get; set; } = null!;

    private PartnerAppOverview? _overview;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync() => _overview = await Partners.GetOverviewAsync(Info.UserId, Info.AppId);

    private string Link(string section) => $"/apps/{Info.AppId:D}/{section}";
}
