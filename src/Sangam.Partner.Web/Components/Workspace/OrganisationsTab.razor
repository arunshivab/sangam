@inject IPartnerService Partners
@inject IOrgConsoleService OrgConsole
@inject IConfiguration Configuration
@inject Sangam.Identity.Application.Apps.IAppDirectory Apps

<p class="sg-lede">@L["The organisations using {0}, and who holds which role in each. A role holds only in the organisation it is given in. Here you can give roles to people who already use {0}; add anyone new in the organisation console, with an activation code or their join code.", Info.AppName]</p>

@if (_orgs is null || _types is null)
{
  <p class="sg-muted">@L["Loading…"]</p>
}
else
{
  <div class="sg-split">
    <section class="sg-panel">
      <h2 class="sg-h3">@L["Organisations"]</h2>
      @if (_orgs.Count == 0)
      {
        <p class="sg-muted">@L["None yet. Add the first one below."]</p>
      }
      @if (_orgs.Count > 6)
      {
        <input class="sg-input sg-input--toolbar sg-tree-search" aria-label="@L["Find an organisation"]" placeholder="@L["Find an organisation"]" @bind="_treeQuery" @bind:event="oninput" />
      }
      <ul class="sg-tree" data-panel="org-tree">
        @foreach (OrganisationDto org in TreeRows)
        {
          <li style="padding-left:@(org.Depth * 1.25)rem">
            <button type="button" class="sg-tree-item @(org.Id == _selected?.Id ? "sg-tree-item--on" : string.Empty)" aria-pressed="@(org.Id == _selected?.Id ? "true" : "false")" @onclick="() => SelectAsync(org)">
              <span class="sg-name">@org.Name</span>
              <span class="sg-sub">@TypeName(org.Type) · @PeopleText(org.Id)</span>
            </button>
          </li>
        }
      </ul>

      @if (!CanAddUnderSelected)
      {
        <p class="sg-muted">@L["{0} organisations cannot have others under them.", TypeName(_selected!.Type)]</p>
        <div class="sg-actions">
          <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _selected = null">@L["Add at top level instead"]</button>
        </div>
      }
      else
      {
      <h3 class="sg-h3">@(_selected is null ? L["Add a top-level organisation"] : L["Add an organisation under {0}", _selected.Name])</h3>
      <div class="sg-form-row">
        <label class="sg-label" for="org-name">@L["Name"]</label>
        <input id="org-name" class="sg-input" @bind="_newName" @bind:event="oninput" />
      </div>
      <div class="sg-form-row">
        <label class="sg-label" for="org-type">@L["Kind"]</label>
        <select id="org-type" class="sg-input" @bind="_newType">
          <option value="">@L["Choose…"]</option>
          @foreach (OrgTypeRow type in _types.Where(t => _selected is not null || t.CanBeRoot))
          {
            <option value="@type.Code">@TypeName(type.Code)</option>
          }
        </select>
      </div>
      <div class="sg-actions">
        @if (_selected is not null)
        {
          <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _selected = null">@L["Add at top level instead"]</button>
        }
        <button type="button" class="sg-btn sg-btn--primary" @onclick="CreateOrgAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName) || string.IsNullOrEmpty(_newType))">@L["Add organisation"]</button>
      </div>
      }
    </section>

    <section class="sg-panel">
      @if (_selected is null)
      {
        <p class="sg-muted">@L["Choose an organisation to see and change who holds roles in it."]</p>
      }
      else
      {
        <h2 class="sg-h3">@L["People in {0}", _selected.Name]</h2>
        @if (_members is null || _members.Count == 0)
        {
          <p class="sg-muted">@L["Nobody holds a role here yet."]</p>
        }
        else
        {
          <div class="sg-table-wrap" tabindex="0" role="region" aria-label="@L["People in {0}", _selected.Name]">
            <table class="sg-table sg-table--cards">
              <thead><tr><th>@L["Person"]</th><th>@L["Roles"]</th><th>@L["Until"]</th><th></th></tr></thead>
              <tbody>
                @foreach (PartnerMemberRow member in _members)
                {
                  <tr class="@(member.UserId == _changing?.UserId ? "sg-row--selected" : null)">
                    <td><span class="sg-name">@member.DisplayName</span><span class="sg-sub">@member.Email</span></td>
                    <td class="sg-mono" data-label="@L["Roles"]">@(string.IsNullOrEmpty(member.Role) ? L["Staff"] : member.Role)</td>
                    <td data-label="@L["Until"]">
                      @if (member.ExpiresAt is DateTimeOffset until)
                      {
                        <span class="@(until - DateTimeOffset.UtcNow < TimeSpan.FromDays(30) ? "sg-warn-text" : null)">@L["Ends {0}", IndiaTime.Date(until)]</span>
                      }
                      else
                      {
                        @L["Ongoing"]
                      }
                    </td>
                    <td class="sg-row-actions-cell"><button type="button" class="sg-btn sg-btn--secondary sg-btn--row" @onclick="() => StartChange(member)" disabled="@_busy">@L["Change"]</button></td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }

        @if (_changing is not null)
        {
          @* rc.11 (R3): ending a role is never one click: on a date or now, with a reason the person reads in their Activity. *@
          <section class="sg-end-role" data-panel="end-role" aria-labelledby="end-role-title">
            <h3 class="sg-h3" id="end-role-title">@L["End {0}'s place here?", _changing.DisplayName]</h3>
            <div class="sg-end-role-row" role="radiogroup" aria-labelledby="end-role-title">
              <label class="sg-option-inline @(_endNow ? null : "sg-option-inline--on")">
                <input type="radio" name="end-when" checked="@(!_endNow)" @onchange="() => _endNow = false" />
                <span>@L["On a date"]</span>
                <input class="sg-input sg-input--toolbar" type="date" aria-label="@L["The last day of the role"]" @bind="_endsOn" disabled="@_endNow"
                       min="@IndiaTime.ToIndia(DateTimeOffset.UtcNow).AddDays(1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
              </label>
              <label class="sg-option-inline @(_endNow ? "sg-option-inline--on" : null)">
                <input type="radio" name="end-when" checked="@_endNow" @onchange="() => _endNow = true" />
                <span>@L["Now"]</span>
              </label>
            </div>
            <label class="sg-label" for="end-reason">@L["Reason (the person sees it in their Activity)"]</label>
            <input id="end-reason" class="sg-input" maxlength="300" @bind="_endReason" @bind:event="oninput" />
            <div class="sg-actions">
              <button type="button" class="sg-btn sg-btn--secondary" @onclick="() => _changing = null">@L["Keep role"]</button>
              <button type="button" class="sg-btn sg-btn--danger" @onclick="EndAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_endReason) || (!_endNow && _endsOn is null))">
                @(_endNow ? L["End role now"] : _endsOn is DateOnly d ? L["End role on {0}", d.ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture)] : L["End role on a date"])
              </button>
            </div>
          </section>
        }

        <h3 class="sg-h3">@L["Give someone a role here"]</h3>
        <div class="sg-search">
          <input class="sg-input" aria-label="@L["Name or email"]" placeholder="@L["Name or email of someone who uses {0}", Info.AppName]" @bind="_query" @bind:event="oninput" @onkeydown="SearchOnEnterAsync" />
          <button type="button" class="sg-btn sg-btn--secondary" @onclick="SearchAsync" disabled="@_busy">@L["Search"]</button>
        </div>
        @if (_found is not null)
        {
          @if (_found.Count == 0)
          {
            <p class="sg-muted">@L["Nobody who uses {0} matches. If they have never signed in to it, invite them by email below.", Info.AppName]</p>
          }
          <ul class="sg-list">
            @foreach (LinkedUserRow person in _found)
            {
              <li>
                <button type="button" class="sg-tree-item @(person.UserId == _pick?.UserId ? "sg-tree-item--on" : string.Empty)" @onclick="() => _pick = person">
                  <span class="sg-name">@person.DisplayName</span><span class="sg-sub">@person.Email</span>
                </button>
              </li>
            }
          </ul>
        }
        @if (_pick is not null)
        {
          <div class="sg-form-row">
            <label class="sg-label" for="grant-role">@L["Role for {0}", _pick.DisplayName]</label>
            <select id="grant-role" class="sg-input" @bind="_grantRole">
              <option value="">@L["Choose…"]</option>
              @foreach (RoleDto role in _roles ?? [])
              {
                <option value="@role.Code">@role.DisplayName</option>
              }
            </select>
          </div>
          <div class="sg-form-row">
            <label class="sg-label" for="grant-until">@L["Until (optional: for a contractor or an auditor, the role ends by itself at the end of this day)"]</label>
            <input id="grant-until" class="sg-input" type="date" @bind="_until" min="@IndiaTime.ToIndia(DateTimeOffset.UtcNow).AddDays(1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
          </div>
          <div class="sg-actions">
            <button type="button" class="sg-btn sg-btn--primary" @onclick="GrantAsync" disabled="@(_busy || string.IsNullOrEmpty(_grantRole))">@L["Give role"]</button>
          </div>
        }

        @* rc.12: someone new is added in the organisation console: checked first, then an activation code or their join code. *@
        <h3 class="sg-h3">@L["Someone new"]</h3>
        <p class="sg-muted">@L["Add people who do not use {0} yet in the organisation console. Sangam checks their details first; they join with an activation code you hand them, or with a join code from their own portal.", Info.AppName]</p>
        <div class="sg-actions">
          <a class="sg-btn sg-btn--secondary" href="@($"/org/{CustomerOf(_selected):D}/joiners")">@L["Add a new joiner"]</a>
          <a class="sg-btn sg-btn--ghost" href="@($"/org/{CustomerOf(_selected):D}")">@L["Open the organisation console"]</a>
        </div>

        @if (_selected.ParentId is null)
        {
          @* rc.12: a customer that leaves the application is closed: every place and admin right under it ends at once. *@
          <section class="sg-end-role" data-panel="close-customer" aria-labelledby="close-title">
            <h3 class="sg-h3" id="close-title">@L["Close {0}", _selected.Name]</h3>
            <p class="sg-muted">@L["When {0} stops using {1}: everyone's places and admin rights under it end now, the people are told, and their Sangam accounts stay theirs. This cannot be undone here.", _selected.Name, Info.AppName]</p>
            @if (_closing)
            {
              <label class="sg-label" for="close-reason">@L["Reason"]</label>
              <input id="close-reason" class="sg-input" maxlength="300" @bind="_closeReason" @bind:event="oninput" />
              <div class="sg-actions">
                <button type="button" class="sg-btn sg-btn--secondary" @onclick="() => _closing = false">@L["Keep {0}", _selected.Name]</button>
                <button type="button" class="sg-btn sg-btn--danger" @onclick="CloseAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_closeReason))">@L["Close {0} now", _selected.Name]</button>
              </div>
            }
            else
            {
              <div class="sg-actions">
                <button type="button" class="sg-btn sg-btn--danger" @onclick="() => { _closing = true; _closeReason = string.Empty; }">@L["Close this customer…"]</button>
              </div>
            }
          </section>
        }

        @if (_testersJoin is bool testersJoin)
        {
          @* rc.13 (decision of 19 Oct 2026): for a made-up demo organisation only, people may give themselves a place. *@
          <section class="sg-end-role" data-panel="testers-join" aria-labelledby="testers-title">
            <h3 class="sg-h3" id="testers-title">@L["Testers may join themselves"]</h3>
            <p class="sg-muted">@L["For a made-up demo organisation only. When it is on, anyone signed in to {0} can give themselves a place in {1} through {0}, with no admin asking; each joins in their own name. It does not reach the organisations under it.", Info.AppName, _selected.Name]</p>
            <div class="sg-actions">
              <button type="button" class="sg-btn @(testersJoin ? "sg-btn--danger" : "sg-btn--secondary")" aria-pressed="@(testersJoin ? "true" : "false")" @onclick="SwitchTestersAsync" disabled="@_busy">
                @(testersJoin ? L["Switch off"] : L["Switch on"])
              </button>
            </div>
          </section>
        }

        @if (_policy is not null)
        {
          <h3 class="sg-h3" data-panel="org-policy">@L["Security policy for {0}", _selected.Name]</h3>
          <PolicyEditor View="_policy" Key="@($"org-{_selected.Id:N}")" ShowSignIn="true" InheritLabel="@PolicyParent" Busy="_busy" OnSave="SavePolicyAsync"
                        Explanation="@L["Applies to everyone with a role in {0} and in every organisation under it, when they sign in to {1}. It can only be stricter than what {0} already has to follow.", _selected.Name, Info.AppName].Value" />
        }

        @* PR-19: tenant overrides — this organisation's sign-in page and messages, for it and everything under it.
           The two editors are siblings, so their keys must differ (one shared key ended the circuit on every click). *@
        <BrandingEditor @key="@($"branding-{_selected.Id:N}")" UserId="Info.UserId" Scope="CustomisationScope.Organisation" ScopeId="_selected.Id" Heading="@L["Sign-in page for {0}", _selected.Name].Value"
                        IdentityBaseUrl="@Authority" PreviewUrl="@OrgPreviewUrl" Key="@($"org-branding-{_selected.Id:N}")" />
        <TemplateEditor @key="@($"templates-{_selected.Id:N}")" UserId="Info.UserId" Scope="CustomisationScope.Organisation" ScopeId="_selected.Id" Heading="@L["Messages for {0}", _selected.Name].Value"
                        PreviewHeading="@Info.AppName" Key="@($"org-templates-{_selected.Id:N}")" />
      }
    </section>
  </div>
}

<StatusLine Ok="_ok" Message="@_message" />

@code {
    /// <summary>The application being worked on.</summary>
    [Parameter]
    [EditorRequired]
    public WorkspaceInfo Info { get; set; } = null!;

    private IReadOnlyList<OrganisationDto>? _orgs;
    private IReadOnlyList<OrgTypeRow>? _types;
    private IReadOnlyList<RoleDto>? _roles;
    private IReadOnlyList<PartnerMemberRow>? _members;
    private IReadOnlyList<LinkedUserRow>? _found;
    private OrganisationDto? _selected;
    private LinkedUserRow? _pick;
    private string _newName = string.Empty;
    private string _newType = string.Empty;
    private string _query = string.Empty;
    private string _grantRole = string.Empty;
    private DateOnly? _until;
    private bool _closing;
    private string _closeReason = string.Empty;
    private bool _busy;
    private PolicyView? _policy;
    private bool? _testersJoin;
    private bool _ok;
    private string? _message;
    private PartnerMemberRow? _changing;
    private bool _endNow;
    private DateOnly? _endsOn;
    private string _endReason = string.Empty;
    private string _treeQuery = string.Empty;
    private IReadOnlyDictionary<Guid, int> _counts = new Dictionary<Guid, int>();

    private string? _clientId;

    private string Authority => Configuration["Sangam:Authority"] ?? "https://id.sangamid.in";

    // An application names the organisation in its sign-in request (sangam_org) to get its branding.
    private string? OrgPreviewUrl => _clientId is null || _selected is null ? null
        : Authority + "/login?returnUrl=" + Uri.EscapeDataString("/connect/authorize?client_id=" + _clientId + "&sangam_org=" + _selected.Id.ToString("D"));

    protected override async Task OnInitializedAsync()
    {
        _clientId = (await Apps.FindByIdAsync(Info.AppId))?.ClientId;
        _types = await Partners.ListOrgTypesAsync();
        _roles = (await Partners.ListRolesAsync(Info.UserId, Info.AppId)).Where(r => r.RetiredAt is null).ToList();
        _orgs = await Partners.ListOrganisationsAsync(Info.UserId, Info.AppId);
        _counts = await Partners.CountPeopleAsync(Info.UserId, Info.AppId);
    }

    // Mirrors the rule the management service enforces, so the page never offers a form that can only be refused.
    private bool CanAddUnderSelected => _selected is null || (_types?.FirstOrDefault(t => t.Code == _selected.Type)?.CanHaveChildren ?? true);

    // The built-in organisation types in the reader's language (PR-18); a type added later shows its own name.
    private string TypeName(string code) => code switch
    {
        "corporate" => L["Corporate group"],
        "hospital" => L["Hospital"],
        "clinic" => L["Clinic / Practice"],
        "lab" => L["Diagnostic laboratory"],
        "department" => L["Department"],
        "construction_firm" => L["Construction firm"],
        "education" => L["Educational institution"],
        "other" => L["Other"],
        _ => _types?.FirstOrDefault(t => t.Code == code)?.DisplayName ?? code,
    };

    private async Task SelectAsync(OrganisationDto org)
    {
        _selected = org;
        _pick = null;
        _found = null;
        _query = string.Empty;
        _message = null;
        _changing = null;
        _members = await Partners.ListMembersAsync(Info.UserId, Info.AppId, org.Id);
        _policy = await Partners.GetOrganisationPolicyAsync(Info.UserId, Info.AppId, org.Id);
        _testersJoin = await OrgConsole.TestersMayJoinAsync(Info.UserId, Info.AppId, org.Id);
    }

    private async Task SwitchTestersAsync()
    {
        _busy = true;
        PartnerResult result = await OrgConsole.SetTestersMayJoinAsync(Info.UserId, Info.AppId, _selected!.Id, _testersJoin != true);
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        _testersJoin = await OrgConsole.TestersMayJoinAsync(Info.UserId, Info.AppId, _selected.Id);
    }

    private string PolicyParent => _selected?.ParentId is null ? L["the application"] : L["the organisations above"];

    private async Task SavePolicyAsync(PolicyInput input)
    {
        _busy = true;
        PartnerResult result = await Partners.UpdateOrganisationPolicyAsync(Info.UserId, Info.AppId, _selected!.Id, input);
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        _policy = await Partners.GetOrganisationPolicyAsync(Info.UserId, Info.AppId, _selected.Id);
    }

    private async Task CreateOrgAsync()
    {
        _busy = true;
        PartnerResult result = await Partners.UpsertOrganisationAsync(
            Info.UserId, Info.AppId, Guid.NewGuid(), new OrganisationUpsert(_newName.Trim(), _newType, _selected?.Id, null));
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _newName = string.Empty;
            _newType = string.Empty;
            _orgs = await Partners.ListOrganisationsAsync(Info.UserId, Info.AppId);
        }
    }

    private async Task SearchOnEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        _pick = null;
        _found = await Partners.SearchLinkedUsersAsync(Info.UserId, Info.AppId, _query, 20);
    }

    /// <summary>The end of the chosen day, India time (PR-25).</summary>
    private static DateTimeOffset? Until(DateOnly? day) => day is DateOnly d ? new DateTimeOffset(d.ToDateTime(new TimeOnly(23, 59, 59)), IndiaTime.Offset) : null;

    private async Task GrantAsync()
    {
        _busy = true;
        PartnerResult result = await Partners.GrantMembershipAsync(
            Info.UserId, Info.AppId, _selected!.Id, _pick!.UserId, new MembershipUpsert(_grantRole, false, Until(_until)));
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _pick = null;
            _found = null;
            _query = string.Empty;
            _grantRole = string.Empty;
            _until = null;
            _members = await Partners.ListMembersAsync(Info.UserId, Info.AppId, _selected.Id);
            _counts = await Partners.CountPeopleAsync(Info.UserId, Info.AppId);
        }
    }

    private void StartChange(PartnerMemberRow member)
    {
        _changing = member;
        _endNow = false;
        _endsOn = null;
        _endReason = string.Empty;
        _message = null;
    }

    private async Task EndAsync()
    {
        _busy = true;
        PartnerResult result = await Partners.EndMembershipAsync(Info.UserId, Info.AppId, _selected!.Id, _changing!.UserId, _endNow ? null : _endsOn, _endReason);
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _changing = null;
            _members = await Partners.ListMembersAsync(Info.UserId, Info.AppId, _selected.Id);
            _counts = await Partners.CountPeopleAsync(Info.UserId, Info.AppId);
        }
    }

    // rc.12: a closed customer (and everything under it) is gone from the tree.
    private IEnumerable<OrganisationDto> TreeRows => string.IsNullOrWhiteSpace(_treeQuery)
        ? (_orgs ?? []).Where(o => o.Status != OrganisationStatus.Closed)
        : (_orgs ?? []).Where(o => o.Status != OrganisationStatus.Closed && o.Name.Contains(_treeQuery.Trim(), StringComparison.CurrentCultureIgnoreCase));

    private string PeopleText(Guid orgId)
    {
        int people = _counts.GetValueOrDefault(orgId);
        return people == 1 ? L["1 person"] : L["{0} people", people];
    }

    // The customer an organisation belongs to (the first id on its path).
    private static Guid CustomerOf(OrganisationDto org) => OrganisationPathIds(org.Path).FirstOrDefault(org.Id);

    private static IEnumerable<Guid> OrganisationPathIds(string path)
        => path.Split('/', StringSplitOptions.RemoveEmptyEntries).Select(p => Guid.TryParse(p, out Guid id) ? id : Guid.Empty).Where(id => id != Guid.Empty);

    private async Task CloseAsync()
    {
        _busy = true;
        PartnerResult result = await OrgConsole.CloseCustomerAsync(Info.UserId, Info.AppId, _selected!.Id, _closeReason);
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _closing = false;
            _selected = null;
            _orgs = await Partners.ListOrganisationsAsync(Info.UserId, Info.AppId);
            _counts = await Partners.CountPeopleAsync(Info.UserId, Info.AppId);
        }
    }
}
