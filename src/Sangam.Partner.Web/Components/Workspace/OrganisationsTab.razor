@inject IPartnerService Partners
@inject IInvitationService Invitations
@inject IConfiguration Configuration
@inject Sangam.Identity.Application.Apps.IAppDirectory Apps

<p class="sg-lede">@L["The organisations using {0}, and who holds which role in each. You can only give roles to people who have already signed in to {0} and allowed it access — Sangam never lets an application look up anyone else.", Info.AppName]</p>

@if (_orgs is null || _types is null)
{
  <p class="sg-muted">@L["Loading…"]</p>
}
else
{
  <div class="sg-split">
    <section class="sg-panel">
      <h2 class="sg-h3">@L["Organisations"]</h2>
      @if (_orgs.Count == 0)
      {
        <p class="sg-muted">@L["None yet. Add the first one below."]</p>
      }
      <ul class="sg-tree">
        @foreach (OrganisationDto org in _orgs)
        {
          <li style="padding-left:@(org.Depth * 1.25)rem">
            <button type="button" class="sg-tree-item @(org.Id == _selected?.Id ? "sg-tree-item--on" : string.Empty)" aria-pressed="@(org.Id == _selected?.Id ? "true" : "false")" @onclick="() => SelectAsync(org)">
              <span class="sg-name">@org.Name</span>
              <span class="sg-sub">@TypeName(org.Type)</span>
            </button>
          </li>
        }
      </ul>

      @if (!CanAddUnderSelected)
      {
        <p class="sg-muted">@L["{0} organisations cannot have others under them.", TypeName(_selected!.Type)]</p>
        <div class="sg-actions">
          <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _selected = null">@L["Add at top level instead"]</button>
        </div>
      }
      else
      {
      <h3 class="sg-h3">@(_selected is null ? L["Add a top-level organisation"] : L["Add an organisation under {0}", _selected.Name])</h3>
      <div class="sg-form-row">
        <label class="sg-label" for="org-name">@L["Name"]</label>
        <input id="org-name" class="sg-input" @bind="_newName" @bind:event="oninput" />
      </div>
      <div class="sg-form-row">
        <label class="sg-label" for="org-type">@L["Kind"]</label>
        <select id="org-type" class="sg-input" @bind="_newType">
          <option value="">@L["Choose…"]</option>
          @foreach (OrgTypeRow type in _types.Where(t => _selected is not null || t.CanBeRoot))
          {
            <option value="@type.Code">@TypeName(type.Code)</option>
          }
        </select>
      </div>
      <div class="sg-actions">
        @if (_selected is not null)
        {
          <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _selected = null">@L["Add at top level instead"]</button>
        }
        <button type="button" class="sg-btn sg-btn--primary" @onclick="CreateOrgAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName) || string.IsNullOrEmpty(_newType))">@L["Add organisation"]</button>
      </div>
      }
    </section>

    <section class="sg-panel">
      @if (_selected is null)
      {
        <p class="sg-muted">@L["Choose an organisation to see and change who holds roles in it."]</p>
      }
      else
      {
        <h2 class="sg-h3">@L["People in {0}", _selected.Name]</h2>
        @if (_members is null || _members.Count == 0)
        {
          <p class="sg-muted">@L["Nobody holds a role here yet."]</p>
        }
        else
        {
          <div class="sg-table-wrap">
            <table class="sg-table">
              <thead><tr><th>@L["Person"]</th><th>@L["Role"]</th><th>@L["Reaches"]</th><th></th></tr></thead>
              <tbody>
                @foreach (PartnerMemberRow member in _members)
                {
                  <tr>
                    <td><span class="sg-name">@member.DisplayName</span><span class="sg-sub">@member.Email</span></td>
                    <td class="sg-mono">@member.Role
                      @if (member.ExpiresAt is DateTimeOffset until)
                      {
                        <span class="sg-sub">@L["until {0}", IndiaTime.Date(until)]</span>
                      }
                    </td>
                    <td>@(member.AppliesToDescendants ? L["this and everything under it"] : L["only this"])</td>
                    <td><button type="button" class="sg-btn sg-btn--ghost" @onclick="() => RevokeAsync(member)" disabled="@_busy">@L["Remove"]</button></td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }

        <h3 class="sg-h3">@L["Give someone a role here"]</h3>
        <div class="sg-search">
          <input class="sg-input" aria-label="@L["Name or email"]" placeholder="@L["Name or email of someone who uses {0}", Info.AppName]" @bind="_query" @bind:event="oninput" @onkeydown="SearchOnEnterAsync" />
          <button type="button" class="sg-btn sg-btn--secondary" @onclick="SearchAsync" disabled="@_busy">@L["Search"]</button>
        </div>
        @if (_found is not null)
        {
          @if (_found.Count == 0)
          {
            <p class="sg-muted">@L["Nobody who uses {0} matches. If they have never signed in to it, invite them by email below.", Info.AppName]</p>
          }
          <ul class="sg-list">
            @foreach (LinkedUserRow person in _found)
            {
              <li>
                <button type="button" class="sg-tree-item @(person.UserId == _pick?.UserId ? "sg-tree-item--on" : string.Empty)" @onclick="() => _pick = person">
                  <span class="sg-name">@person.DisplayName</span><span class="sg-sub">@person.Email</span>
                </button>
              </li>
            }
          </ul>
        }
        @if (_pick is not null)
        {
          <div class="sg-form-row">
            <label class="sg-label" for="grant-role">@L["Role for {0}", _pick.DisplayName]</label>
            <select id="grant-role" class="sg-input" @bind="_grantRole">
              <option value="">@L["Choose…"]</option>
              @foreach (RoleDto role in _roles ?? [])
              {
                <option value="@role.Code">@role.DisplayName</option>
              }
            </select>
          </div>
          <label class="sg-check"><input type="checkbox" @bind="_descendants" /> @L["Also everything under {0}", _selected.Name]</label>
          <div class="sg-form-row">
            <label class="sg-label" for="grant-until">@L["Until (optional: for a contractor or an auditor, the role ends by itself at the end of this day)"]</label>
            <input id="grant-until" class="sg-input" type="date" @bind="_until" min="@IndiaTime.ToIndia(DateTimeOffset.UtcNow).AddDays(1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
          </div>
          <div class="sg-actions">
            <button type="button" class="sg-btn sg-btn--primary" @onclick="GrantAsync" disabled="@(_busy || string.IsNullOrEmpty(_grantRole))">@L["Give role"]</button>
          </div>
        }

        <h3 class="sg-h3">@L["Invite someone by email"]</h3>
        <p class="sg-muted">@L["They get a link that works once, for 7 days. When they accept it — signed in with this address — they join {0} with the role you choose.", _selected.Name]</p>
        <div class="sg-form-row">
          <label class="sg-label" for="invite-email">@L["Email"]</label>
          <input id="invite-email" class="sg-input" type="email" autocomplete="off" @bind="_inviteEmail" />
        </div>
        <div class="sg-form-row">
          <label class="sg-label" for="invite-role">@L["Role"]</label>
          <select id="invite-role" class="sg-input" @bind="_inviteRole">
            <option value="">@L["Choose…"]</option>
            @foreach (RoleDto role in _roles ?? [])
            {
              <option value="@role.Code">@role.DisplayName</option>
            }
          </select>
        </div>
        <label class="sg-check"><input type="checkbox" @bind="_inviteDescendants" /> @L["Also everything under {0}", _selected.Name]</label>
        <div class="sg-actions">
          <button type="button" class="sg-btn sg-btn--secondary" @onclick="InviteAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_inviteEmail) || string.IsNullOrEmpty(_inviteRole))">@L["Send invitation"]</button>
        </div>

        @if (_policy is not null)
        {
          <h3 class="sg-h3" data-panel="org-policy">@L["Security policy for {0}", _selected.Name]</h3>
          <PolicyEditor View="_policy" Key="@($"org-{_selected.Id:N}")" ShowSignIn="true" InheritLabel="@PolicyParent" Busy="_busy" OnSave="SavePolicyAsync"
                        Explanation="@L["Applies to everyone with a role in {0} and in every organisation under it, when they sign in to {1}. It can only be stricter than what {0} already has to follow.", _selected.Name, Info.AppName].Value" />
        }

        @* PR-19: tenant overrides — this organisation's sign-in page and messages, for it and everything under it.
           The two editors are siblings, so their keys must differ (one shared key ended the circuit on every click). *@
        <BrandingEditor @key="@($"branding-{_selected.Id:N}")" UserId="Info.UserId" Scope="CustomisationScope.Organisation" ScopeId="_selected.Id" Heading="@L["Sign-in page for {0}", _selected.Name].Value"
                        IdentityBaseUrl="@Authority" PreviewUrl="@OrgPreviewUrl" Key="@($"org-branding-{_selected.Id:N}")" />
        <TemplateEditor @key="@($"templates-{_selected.Id:N}")" UserId="Info.UserId" Scope="CustomisationScope.Organisation" ScopeId="_selected.Id" Heading="@L["Messages for {0}", _selected.Name].Value"
                        PreviewHeading="@Info.AppName" Key="@($"org-templates-{_selected.Id:N}")" />
      }
    </section>
  </div>
}

<StatusLine Ok="_ok" Message="@_message" />

@code {
    /// <summary>The application being worked on.</summary>
    [Parameter]
    [EditorRequired]
    public WorkspaceInfo Info { get; set; } = null!;

    private IReadOnlyList<OrganisationDto>? _orgs;
    private IReadOnlyList<OrgTypeRow>? _types;
    private IReadOnlyList<RoleDto>? _roles;
    private IReadOnlyList<PartnerMemberRow>? _members;
    private IReadOnlyList<LinkedUserRow>? _found;
    private OrganisationDto? _selected;
    private LinkedUserRow? _pick;
    private string _newName = string.Empty;
    private string _newType = string.Empty;
    private string _query = string.Empty;
    private string _grantRole = string.Empty;
    private DateOnly? _until;
    private bool _descendants;
    private string _inviteEmail = string.Empty;
    private string _inviteRole = string.Empty;
    private bool _inviteDescendants;
    private bool _busy;
    private PolicyView? _policy;
    private bool _ok;
    private string? _message;

    private string? _clientId;

    private string Authority => Configuration["Sangam:Authority"] ?? "https://id.sangamid.in";

    // An application names the organisation in its sign-in request (sangam_org) to get its branding.
    private string? OrgPreviewUrl => _clientId is null || _selected is null ? null
        : Authority + "/login?returnUrl=" + Uri.EscapeDataString("/connect/authorize?client_id=" + _clientId + "&sangam_org=" + _selected.Id.ToString("D"));

    protected override async Task OnInitializedAsync()
    {
        _clientId = (await Apps.FindByIdAsync(Info.AppId))?.ClientId;
        _types = await Partners.ListOrgTypesAsync();
        _roles = (await Partners.ListRolesAsync(Info.UserId, Info.AppId)).Where(r => r.RetiredAt is null).ToList();
        _orgs = await Partners.ListOrganisationsAsync(Info.UserId, Info.AppId);
    }

    // Mirrors the rule the management service enforces, so the page never offers a form that can only be refused.
    private bool CanAddUnderSelected => _selected is null || (_types?.FirstOrDefault(t => t.Code == _selected.Type)?.CanHaveChildren ?? true);

    // The built-in organisation types in the reader's language (PR-18); a type added later shows its own name.
    private string TypeName(string code) => code switch
    {
        "corporate" => L["Corporate group"],
        "hospital" => L["Hospital"],
        "clinic" => L["Clinic / Practice"],
        "lab" => L["Diagnostic laboratory"],
        "department" => L["Department"],
        "construction_firm" => L["Construction firm"],
        "education" => L["Educational institution"],
        "other" => L["Other"],
        _ => _types?.FirstOrDefault(t => t.Code == code)?.DisplayName ?? code,
    };

    private async Task SelectAsync(OrganisationDto org)
    {
        _selected = org;
        _pick = null;
        _found = null;
        _query = string.Empty;
        _message = null;
        _members = await Partners.ListMembersAsync(Info.UserId, Info.AppId, org.Id);
        _policy = await Partners.GetOrganisationPolicyAsync(Info.UserId, Info.AppId, org.Id);
    }

    private string PolicyParent => _selected?.ParentId is null ? L["the application"] : L["the organisations above"];

    private async Task SavePolicyAsync(PolicyInput input)
    {
        _busy = true;
        PartnerResult result = await Partners.UpdateOrganisationPolicyAsync(Info.UserId, Info.AppId, _selected!.Id, input);
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        _policy = await Partners.GetOrganisationPolicyAsync(Info.UserId, Info.AppId, _selected.Id);
    }

    private async Task CreateOrgAsync()
    {
        _busy = true;
        PartnerResult result = await Partners.UpsertOrganisationAsync(
            Info.UserId, Info.AppId, Guid.NewGuid(), new OrganisationUpsert(_newName.Trim(), _newType, _selected?.Id, null));
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _newName = string.Empty;
            _newType = string.Empty;
            _orgs = await Partners.ListOrganisationsAsync(Info.UserId, Info.AppId);
        }
    }

    private async Task SearchOnEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        _pick = null;
        _found = await Partners.SearchLinkedUsersAsync(Info.UserId, Info.AppId, _query, 20);
    }

    /// <summary>The end of the chosen day, India time (PR-25).</summary>
    private static DateTimeOffset? Until(DateOnly? day) => day is DateOnly d ? new DateTimeOffset(d.ToDateTime(new TimeOnly(23, 59, 59)), IndiaTime.Offset) : null;

    private async Task GrantAsync()
    {
        _busy = true;
        PartnerResult result = await Partners.GrantMembershipAsync(
            Info.UserId, Info.AppId, _selected!.Id, _pick!.UserId, new MembershipUpsert(_grantRole, _descendants, Until(_until)));
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _pick = null;
            _found = null;
            _query = string.Empty;
            _grantRole = string.Empty;
            _until = null;
            _descendants = false;
            _members = await Partners.ListMembersAsync(Info.UserId, Info.AppId, _selected.Id);
        }
    }

    private async Task RevokeAsync(PartnerMemberRow member)
    {
        _busy = true;
        PartnerResult result = await Partners.RevokeMembershipAsync(Info.UserId, Info.AppId, _selected!.Id, member.UserId);
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        _members = await Partners.ListMembersAsync(Info.UserId, Info.AppId, _selected.Id);
    }

    private async Task InviteAsync()
    {
        _busy = true;
        PartnerResult result = await Invitations.CreateAsync(Info.UserId, Info.AppId, _selected!.Id, _inviteEmail, _inviteRole, _inviteDescendants);
        _busy = false;
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _inviteEmail = string.Empty;
        }
    }
}
