@inject IPartnerService Partners
@inject IOrgConsoleService OrgConsole
@inject IMfaService Mfa
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

@if (_state == GateState.Checking)
{
    <p class="sg-note">@L["Checking your access…"]</p>
}
else if (_state == GateState.NotAnAdministrator)
{
    <section class="sg-shut">
        <h1 class="sg-shut-title">@L["You do not administer any application or organisation"]</h1>
        <p class="sg-shut-body">
            @L["Your Sangam account is fine — it simply is not an administrator of any application or organisation on Sangam. If you should be, ask an owner of the application, or your hospital's admin, to add you."]
        </p>
        <a class="sg-btn sg-btn--secondary" href="/signout">@L["Sign out"]</a>
    </section>
    <footer class="sg-lang-footer"><LanguagePicker /></footer>
}
else if (_state == GateState.MfaRequired)
{
    <section class="sg-shut">
        <h1 class="sg-shut-title">@L["Set up two-step sign-in first"]</h1>
        <p class="sg-shut-body">
            @L["Administrators must have an authenticator app. Open your Sangam account portal, set one up under Sign-in & security, then sign in here again."]
        </p>
        <a class="sg-btn sg-btn--primary" href="@PortalUrl">@L["Go to your account portal"]</a>
        <a class="sg-btn sg-btn--secondary" href="/signout">@L["Sign out"]</a>
    </section>
    <footer class="sg-lang-footer"><LanguagePicker /></footer>
}
else if (_state == GateState.TwoStepRequired)
{
    <section class="sg-shut" data-panel="two-step-required">
        <h1 class="sg-shut-title">@L["Sign in again with two-step sign-in"]</h1>
        <p class="sg-shut-body">
            @L["The partner console opens only for a sign-in that used two-step sign-in or a passkey, and this one did not. Sign in again: Sangam will ask for your authenticator app or your passkey."]
        </p>
        <a class="sg-btn sg-btn--primary" href="@ReauthUrl">@L["Sign in again"]</a>
        <a class="sg-btn sg-btn--secondary" href="/signout">@L["Sign out"]</a>
    </section>
    <footer class="sg-lang-footer"><LanguagePicker /></footer>
}
else
{
    <CascadingValue Value="_context">@ChildContent</CascadingValue>
}

@code {
    /// <summary>The console, shown only once every bar is cleared.</summary>
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Where to send an administrator who still needs an authenticator.</summary>
    [Parameter]
    public string PortalUrl { get; set; } = "https://account.sangamid.in/security";

    private GateState _state = GateState.Checking;
    private PartnerContext _context = new(Guid.Empty, "Administrator", []);

    private string ReauthUrl => "/reauth?returnUrl=" + Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri));

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        Guid? userId = SignedInUser.Id(state.User);
        if (userId is null)
        {
            _state = GateState.NotAnAdministrator;
            return;
        }

        // Re-read on every visit: an administrator removed a minute ago is out now.
        IReadOnlyList<PartnerAppRow> apps = await Partners.GetMyAppsAsync(userId.Value);

        // rc.12: customer and branch admins (and emergency access reviewers) come in for their organisations.
        IReadOnlyList<OrgScope> scopes = await OrgConsole.ScopesAsync(userId.Value);
        if (apps.Count == 0 && scopes.Count == 0)
        {
            _state = GateState.NotAnAdministrator;
            return;
        }

        // Mandatory, and checked here rather than trusted from the sign-in.
        if (!await Mfa.IsEnrolledAsync(userId.Value))
        {
            _state = GateState.MfaRequired;
            return;
        }

        // rc.10: having an authenticator is not enough; this session must have been signed in with it (or a passkey).
        if (!ConsoleSession.IsTwoStep(state.User))
        {
            _state = GateState.TwoStepRequired;
            return;
        }

        _context = new PartnerContext(userId.Value, SignedInUser.Name(state.User), apps)
        {
            SignInLevel = ConsoleSession.Level(state.User),
            SessionEndsAt = ConsoleSession.EndsAt(state.User),
            Scopes = scopes,
        };
        _state = GateState.Open;
    }

    private enum GateState
    {
        Checking,
        NotAnAdministrator,
        MfaRequired,
        TwoStepRequired,
        Open,
    }
}
