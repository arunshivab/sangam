<span class="sg-bar-who">
  @if (Context is not null)
  {
    <span class="sg-bar-name">@Context.Name</span>
  }
  <a class="sg-bar-out" href="/signout">@L["Sign out"]</a>
</span>

@code {
    /// <summary>The signed-in administrator, cascaded by the gate.</summary>
    [CascadingParameter]
    public PartnerContext? Context { get; set; }
}
