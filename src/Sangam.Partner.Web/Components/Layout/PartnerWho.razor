<div class="sg-side-foot">
  @if (Context is not null)
  {
    <span class="sg-name">@Context.Name</span>
  }
  <a class="sg-side-out" href="/signout">@L["Sign out"]</a>
  <LanguagePicker />
</div>

@code {
    /// <summary>The signed-in administrator, cascaded by the gate.</summary>
    [CascadingParameter]
    public PartnerContext? Context { get; set; }
}
