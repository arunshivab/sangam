@inherits LayoutComponentBase

<PartnerGate PortalUrl="@PortalUrl">
  <PartnerShell>@Body</PartnerShell>
</PartnerGate>

@code {
    [Inject]
    private IConfiguration Configuration { get; set; } = null!;

    private string PortalUrl => (Configuration["Sangam:PortalUrl"] ?? "https://account.sangamid.in") + "/security";
}
