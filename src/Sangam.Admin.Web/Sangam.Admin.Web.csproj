<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- admin.sangamid.in - the platform operator console (Blazor Server, dark scope).
       An OpenID Connect client of id.sangamid.in like any other, with two extra bars:
       the signed-in user must hold an unrevoked platform_operators row, and must have an
       authenticator app enrolled. Every action is authorised in IAdminService by rank,
       and opening a user's record is audited like a change. -->

  <PropertyGroup>
    <RootNamespace>Sangam.Admin.Web</RootNamespace>
    <Description>Sangam identity platform — platform operator console.</Description>
    <UserSecretsId>sangam-admin-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sangam.Identity.Application\Sangam.Identity.Application.csproj" />
    <ProjectReference Include="..\Sangam.Identity.Infrastructure\Sangam.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Sangam.Shared\Sangam.Shared.csproj" />
    <ProjectReference Include="..\Sangam.Web.Shared\Sangam.Web.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sangam.Admin.Web.Tests" />
  </ItemGroup>

</Project>
