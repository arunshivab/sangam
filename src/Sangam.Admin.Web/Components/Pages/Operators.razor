@page "/operators"
@inject IAdminService Admin

<PageTitle>Operators · Sangam console</PageTitle>

<h1 class="sg-h1">Operators</h1>

@if (Context?.IsOwner != true)
{
  <p class="sg-lede">Only an owner can see and manage console access. Your rank is @Context?.RoleLabel.</p>
}
else
{
  <p class="sg-lede">Who may use this console, and how much they may do. Everyone here must have an authenticator app; without one the console refuses them, whatever their rank.</p>

  @if (_rows is null)
  {
    <p class="sg-muted">Loading…</p>
  }
  else
  {
    <table class="sg-table">
      <thead><tr><th>Person</th><th>Rank</th><th>Two-step</th><th>Since</th><th>Granted by</th><th></th></tr></thead>
      <tbody>
        @foreach (OperatorRow row in _rows)
        {
          <tr>
            <td><span class="sg-name">@row.DisplayName</span><span class="sg-sub sg-mono">@row.Email</span></td>
            <td><span class="sg-rank sg-rank--@row.Role.ToString().ToLowerInvariant()">@PlatformRanks.Label(row.Role)</span></td>
            <td>@(row.MfaEnrolled ? "on" : Blocked)</td>
            <td class="sg-mono">@row.GrantedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
            <td>@(row.GrantedByName ?? "bootstrap")</td>
            <td>
              @if (row.UserId != Context.UserId)
              {
                <button type="button" class="sg-btn sg-btn--warn" @onclick="() => RevokeAsync(row)" disabled="@_busy">Revoke</button>
              }
              else
              {
                <span class="sg-muted">you</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>

    <div class="sg-panel">
      <h2 class="sg-h2">Give someone console access</h2>
      <p class="sg-muted">They need a Sangam account already, verified and active. Granting does not create one.</p>
      <div class="sg-grant">
        <input class="sg-input" placeholder="their@email.in" @bind="_email" @bind:event="oninput" aria-label="Email address" />
        <select class="sg-input" @bind="_role" aria-label="Rank">
          @foreach (PlatformRole role in PlatformRanks.All)
          {
            <option value="@role">@PlatformRanks.Label(role)</option>
          }
        </select>
        <button type="button" class="sg-btn sg-btn--primary" @onclick="GrantAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_email))">Grant</button>
      </div>
      <p class="sg-muted">@PlatformRanks.Describe(_role)</p>
    </div>
  }

  @if (_message is not null)
  {
    <p class="@(_ok ? "sg-ok" : "sg-warn")">@_message</p>
  }
}

@code {
    private const string Blocked = "none — cannot sign in";

    [CascadingParameter]
    public ConsoleContext? Context { get; set; }

    private IReadOnlyList<OperatorRow>? _rows;
    private string _email = string.Empty;
    private PlatformRole _role = PlatformRole.Viewer;
    private bool _busy;
    private bool _ok;
    private string? _message;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Context?.IsOwner == true)
        {
            _rows = await Admin.ListOperatorsAsync(Context.UserId);
        }
    }

    private async Task GrantAsync()
    {
        _busy = true;
        AdminResult result = await Admin.GrantOperatorAsync(Context!.UserId, _email, _role, null);
        _busy = false;
        _ok = result.Succeeded;
        _message = result.Message;
        if (result.Succeeded)
        {
            _email = string.Empty;
        }

        await LoadAsync();
    }

    private async Task RevokeAsync(OperatorRow row)
    {
        _busy = true;
        AdminResult result = await Admin.RevokeOperatorAsync(Context!.UserId, row.UserId, null);
        _busy = false;
        _ok = result.Succeeded;
        _message = result.Message;
        await LoadAsync();
    }
}
