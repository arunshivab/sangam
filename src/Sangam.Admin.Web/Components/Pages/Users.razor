@page "/users"
@inject IAdminService Admin

<PageTitle>@L["Users · Operator console"]</PageTitle>

<h1 class="sg-h1">@L["Users"]</h1>
<p class="sg-lede">@L["Search by name, email or mobile. Opening a record is recorded in that person's own Activity."]</p>

<div class="sg-toolbar" data-panel="filters" @onkeyup="OnKeyAsync">
  <label class="sg-field-label sg-input--search">
    @L["Search"]
    <input class="sg-input sg-input--toolbar" placeholder="@L["Name, email or mobile"]" @bind="_query" @bind:event="oninput" aria-label="@L["Search users"]" />
  </label>
  <label class="sg-field-label">
    @L["Status"]
    <select class="sg-input sg-input--toolbar" @bind="_status">
      <option value="">@L["Any"]</option>
      <option value="active">@L["active"]</option>
      <option value="suspended">@L["suspended"]</option>
      <option value="deletedsoft">@L["deleting"]</option>
    </select>
  </label>
  <label class="sg-field-label">
    @L["Application"]
    <select class="sg-input sg-input--toolbar" @bind="_app">
      <option value="">@L["Any"]</option>
      @foreach (AdminAppRow app in _apps)
      {
        <option value="@app.Id.ToString("D")">@app.DisplayName</option>
      }
    </select>
  </label>
  <label class="sg-field-label">
    @L["Two-step sign-in"]
    <select class="sg-input sg-input--toolbar" @bind="_twoStep">
      <option value="">@L["Any"]</option>
      <option value="yes">@L["authenticator app"]</option>
      <option value="no">@L["none"]</option>
    </select>
  </label>
  <label class="sg-field-label">
    @L["Organisation"]
    <input class="sg-input sg-input--toolbar" placeholder="@L["Organisation name"]" @bind="_organisation" @bind:event="oninput" />
  </label>
  <button type="button" class="sg-btn sg-btn--primary" @onclick="SearchAsync" disabled="@_busy">@L["Search"]</button>
</div>

@if (_page is null)
{
  <p class="sg-muted">@L["Loading…"]</p>
}
else if (_page.Total == 0)
{
  <p class="sg-muted">@L["No account matches that."]</p>
}
else
{
  @if (CanBulk && _chosen.Count > 0)
  {
    @* rc.11 (O2): the only bulk action. It sits in the flow above the table, never floating over it. *@
    <section class="sg-bulk-bar" data-panel="bulk" aria-labelledby="bulk-title">
      <p id="bulk-title"><strong>@(_chosen.Count == 1 ? L["1 person chosen"] : L["{0} people chosen", _chosen.Count])</strong></p>
      @if (_confirming)
      {
        <label class="sg-label" for="bulk-reason">@L["Reason (kept in each person's audit record)"]</label>
        <input id="bulk-reason" class="sg-input" maxlength="300" @bind="_reason" @bind:event="oninput" />
        <p class="sg-muted">@L["They are signed out of Sangam and every application on every device, and must sign in again."]</p>
        <div class="sg-actions">
          <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _confirming = false" disabled="@_busy">@L["Cancel"]</button>
          <button type="button" class="sg-btn sg-btn--danger" @onclick="SignOutChosenAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))">@L["Sign them out everywhere"]</button>
        </div>
      }
      else
      {
        <div class="sg-actions">
          <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _chosen.Clear()">@L["Clear"]</button>
          <button type="button" class="sg-btn sg-btn--warn" @onclick="() => _confirming = true">@L["Sign out everywhere"]</button>
        </div>
      }
    </section>
  }

  @if (_message is not null)
  {
    <p class="@(_ok ? "sg-ok" : "sg-warn")" role="status">@_message</p>
  }

  <div class="sg-table-wrap" tabindex="0" role="region" aria-label="@L["Users"]">
    <table class="sg-table sg-table--cards">
      <thead><tr>@if (CanBulk) { <th class="sg-check-cell"><input type="checkbox" aria-label="@L["Choose everyone on this page"]" checked="@AllChosen" @onchange="ChooseAll" /></th> }<th>@L["Person"]</th><th>@L["Since"]</th><th>@L["Two-step sign-in"]</th><th>@L["Status"]</th><th></th></tr></thead>
      <tbody>
        @foreach (AdminUserRow row in _page.Rows)
        {
          <tr>
            @if (CanBulk)
            {
              <td class="sg-check-cell">
                @if (row.Id != Context!.UserId)
                {
                  <input type="checkbox" aria-label="@L["Choose {0}", row.DisplayName]" checked="@_chosen.Contains(row.Id)" @onchange="e => Choose(row.Id, e.Value is true)" />
                }
              </td>
            }
            <td>
              <span class="sg-name">@row.DisplayName</span>
              <span class="sg-sub sg-mono">@row.Email@(row.Mobile is null ? "" : " · " + row.Mobile)</span>
            </td>
            <td class="sg-mono" data-label="@L["Since"]">@IndiaTime.Date(row.CreatedAt)</td>
            <td data-label="@L["Two-step sign-in"]">@(row.MfaEnrolled ? L["authenticator app"] : L["none"])</td>
            <td data-label="@L["Status"]">
              <span class="sg-pill sg-pill--@row.Status.ToString().ToLowerInvariant()">@Status(row)</span>
              @if (row.IsOperator)
              {
                <span class="sg-pill sg-pill--op">@L["Operator"]</span>
              }
            </td>
            <td><a class="sg-btn sg-btn--ghost" href="@($"/users/{row.Id:D}")">@L["Open"]</a></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  <div class="sg-pager" data-panel="pager">
    <span class="sg-muted">@L["Showing {0}–{1} of {2}", First, First + _page.Rows.Count - 1, _page.Total]</span>
    <span class="sg-pager-buttons">
      <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => GoAsync(_page.Page - 1)" disabled="@(_busy || _page.Page <= 1)">@L["Previous"]</button>
      <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => GoAsync(_page.Page + 1)" disabled="@(_busy || First + _page.Rows.Count - 1 >= _page.Total)">@L["Next"]</button>
    </span>
  </div>
}

@code {
    private const int PageSize = 25;

    [CascadingParameter]
    public ConsoleContext? Context { get; set; }

    private AdminUserPage? _page;
    private string _query = string.Empty;
    private string _status = string.Empty;
    private string _organisation = string.Empty;
    private string _app = string.Empty;
    private string _twoStep = string.Empty;
    private IReadOnlyList<AdminAppRow> _apps = [];
    private bool _busy;
    private readonly HashSet<Guid> _chosen = [];
    private bool _confirming;
    private string? _reason;
    private bool _ok;
    private string? _message;

    private bool CanBulk => Context?.CanAct == true;

    private IEnumerable<Guid> Choosable => _page?.Rows.Select(r => r.Id).Where(id => id != Context?.UserId) ?? [];

    private bool AllChosen => Choosable.Any() && Choosable.All(_chosen.Contains);

    private int First => _page is null ? 0 : ((_page.Page - 1) * _page.PageSize) + 1;

    protected override async Task OnInitializedAsync()
    {
        if (Context is not null)
        {
            _apps = await Admin.ListAppsAsync(Context.UserId);
        }

        await GoAsync(1);
    }

    private Task SearchAsync() => GoAsync(1);

    private void Choose(Guid id, bool chosen)
    {
        if (chosen && _chosen.Count < IAdminService.BulkSignOutLimit)
        {
            _chosen.Add(id);
        }
        else if (!chosen)
        {
            _chosen.Remove(id);
        }
    }

    private void ChooseAll(ChangeEventArgs args)
    {
        bool chosen = args.Value is true;
        foreach (Guid id in Choosable.ToList())
        {
            Choose(id, chosen);
        }
    }

    private async Task SignOutChosenAsync()
    {
        if (Context is null)
        {
            return;
        }

        _busy = true;
        AdminResult result = await Admin.ForceSignOutManyAsync(Context.UserId, [.. _chosen], _reason ?? string.Empty, null);
        _ok = result.Succeeded;
        _message = L[result.Message ?? string.Empty];
        if (result.Succeeded)
        {
            _chosen.Clear();
            _confirming = false;
            _reason = null;
        }

        _busy = false;
    }

    private async Task OnKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await GoAsync(1);
        }
    }

    private async Task GoAsync(int page)
    {
        if (Context is null)
        {
            return;
        }

        _busy = true;
        UserStatus? status = _status switch
        {
            "active" => UserStatus.Active,
            "suspended" => UserStatus.Suspended,
            "deletedsoft" => UserStatus.DeletedSoft,
            _ => null,
        };
        Guid? app = Guid.TryParse(_app, out Guid a) ? a : null;
        bool? twoStep = _twoStep switch { "yes" => true, "no" => false, _ => null };
        _page = await Admin.ListUsersAsync(Context.UserId, new AdminUserQuery(_query, status, _organisation, page, PageSize, app, twoStep));
        _busy = false;
    }

    private string Status(AdminUserRow row) => row.PurgeAfter is not null
        ? (row.OnHold ? L["deletion held"] : L["deleting"])
        : row.Status switch
        {
            UserStatus.Active => L["active"],
            UserStatus.Suspended => L["suspended"],
            UserStatus.DeletedSoft => L["deleting"],
            _ => L["deleted"],
        };
}
