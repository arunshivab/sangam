@page "/users"
@inject IAdminService Admin

<PageTitle>@L["Users · Operator console"]</PageTitle>

<h1 class="sg-h1">@L["Users"]</h1>
<p class="sg-lede">@L["Search by name, email or mobile. Opening a record is recorded in that person's own Activity."]</p>

<div class="sg-toolbar" data-panel="filters" @onkeyup="OnKeyAsync">
  <label class="sg-field-label sg-input--search">
    @L["Search"]
    <input class="sg-input sg-input--toolbar" placeholder="@L["Name, email or mobile"]" @bind="_query" @bind:event="oninput" aria-label="@L["Search users"]" />
  </label>
  <label class="sg-field-label">
    @L["Status"]
    <select class="sg-input sg-input--toolbar" @bind="_status">
      <option value="">@L["Any"]</option>
      <option value="active">@L["active"]</option>
      <option value="suspended">@L["suspended"]</option>
      <option value="deletedsoft">@L["deleting"]</option>
    </select>
  </label>
  <label class="sg-field-label">
    @L["Organisation"]
    <input class="sg-input sg-input--toolbar" placeholder="@L["Organisation name"]" @bind="_organisation" @bind:event="oninput" />
  </label>
  <button type="button" class="sg-btn sg-btn--primary" @onclick="SearchAsync" disabled="@_busy">@L["Search"]</button>
</div>

@if (_page is null)
{
  <p class="sg-muted">@L["Loading…"]</p>
}
else if (_page.Total == 0)
{
  <p class="sg-muted">@L["No account matches that."]</p>
}
else
{
  <div class="sg-table-wrap" tabindex="0" role="region" aria-label="@L["Users"]">
    <table class="sg-table">
      <thead><tr><th>@L["Person"]</th><th>@L["Since"]</th><th>@L["Two-step sign-in"]</th><th>@L["Status"]</th><th></th></tr></thead>
      <tbody>
        @foreach (AdminUserRow row in _page.Rows)
        {
          <tr>
            <td>
              <span class="sg-name">@row.DisplayName</span>
              <span class="sg-sub sg-mono">@row.Email@(row.Mobile is null ? "" : " · " + row.Mobile)</span>
            </td>
            <td class="sg-mono">@IndiaTime.Date(row.CreatedAt)</td>
            <td>@(row.MfaEnrolled ? L["authenticator app"] : L["none"])</td>
            <td>
              <span class="sg-pill sg-pill--@row.Status.ToString().ToLowerInvariant()">@Status(row)</span>
              @if (row.IsOperator)
              {
                <span class="sg-pill sg-pill--op">@L["Operator"]</span>
              }
            </td>
            <td><a class="sg-btn sg-btn--ghost" href="@($"/users/{row.Id:D}")">@L["Open"]</a></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  <div class="sg-pager" data-panel="pager">
    <span class="sg-muted">@L["Showing {0}–{1} of {2}", First, First + _page.Rows.Count - 1, _page.Total]</span>
    <span class="sg-pager-buttons">
      <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => GoAsync(_page.Page - 1)" disabled="@(_busy || _page.Page <= 1)">@L["Previous"]</button>
      <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => GoAsync(_page.Page + 1)" disabled="@(_busy || First + _page.Rows.Count - 1 >= _page.Total)">@L["Next"]</button>
    </span>
  </div>
}

@code {
    private const int PageSize = 25;

    [CascadingParameter]
    public ConsoleContext? Context { get; set; }

    private AdminUserPage? _page;
    private string _query = string.Empty;
    private string _status = string.Empty;
    private string _organisation = string.Empty;
    private bool _busy;

    private int First => _page is null ? 0 : ((_page.Page - 1) * _page.PageSize) + 1;

    protected override Task OnInitializedAsync() => GoAsync(1);

    private Task SearchAsync() => GoAsync(1);

    private async Task OnKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await GoAsync(1);
        }
    }

    private async Task GoAsync(int page)
    {
        if (Context is null)
        {
            return;
        }

        _busy = true;
        UserStatus? status = _status switch
        {
            "active" => UserStatus.Active,
            "suspended" => UserStatus.Suspended,
            "deletedsoft" => UserStatus.DeletedSoft,
            _ => null,
        };
        _page = await Admin.ListUsersAsync(Context.UserId, new AdminUserQuery(_query, status, _organisation, page, PageSize));
        _busy = false;
    }

    private string Status(AdminUserRow row) => row.PurgeAfter is not null
        ? (row.OnHold ? L["deletion held"] : L["deleting"])
        : row.Status switch
        {
            UserStatus.Active => L["active"],
            UserStatus.Suspended => L["suspended"],
            UserStatus.DeletedSoft => L["deleting"],
            _ => L["deleted"],
        };
}
