@page "/"
@inject IAdminService Admin
@inject NavigationManager Nav

<PageTitle>@L["Users · Sangam console"]</PageTitle>

<h1 class="sg-h1">@L["Users"]</h1>
<p class="sg-lede">@L["Search by name, email or mobile. Opening a record is recorded in that person's own audit log."]</p>

<div class="sg-search">
  <input class="sg-input" placeholder="@L["Name, email or mobile"]" @bind="_query" @bind:event="oninput" @onkeyup="OnKeyAsync" aria-label="@L["Search users"]" />
  <button type="button" class="sg-btn sg-btn--primary" @onclick="SearchAsync" disabled="@_busy">@L["Search"]</button>
</div>

@if (_rows is null)
{
  <p class="sg-muted">@L["Loading…"]</p>
}
else if (_rows.Count == 0)
{
  <p class="sg-muted">@L["No account matches that."]</p>
}
else
{
  <table class="sg-table">
    <thead><tr><th>@L["Person"]</th><th>@L["Status"]</th><th>@L["Two-step"]</th><th>@L["Joined"]</th><th></th></tr></thead>
    <tbody>
      @foreach (AdminUserRow row in _rows)
      {
        <tr>
          <td>
            <span class="sg-name">@row.DisplayName</span>
            <span class="sg-sub sg-mono">@row.Email@(row.Mobile is null ? "" : " · " + row.Mobile)</span>
          </td>
          <td>
            <span class="sg-pill sg-pill--@row.Status.ToString().ToLowerInvariant()">@Status(row)</span>
            @if (row.IsOperator)
            {
              <span class="sg-pill sg-pill--op">@L["console"]</span>
            }
          </td>
          <td>@(row.MfaEnrolled ? "on" : "—")</td>
          <td class="sg-mono">@IndiaTime.Date(row.CreatedAt)</td>
          <td><a class="sg-btn sg-btn--ghost" href="@($"/users/{row.Id:D}")">@L["Open"]</a></td>
        </tr>
      }
    </tbody>
  </table>
  <p class="sg-muted">@(_rows.Count >= 50 ? L["{0} shown, narrow the search to see more.", _rows.Count] : L["{0} shown.", _rows.Count])</p>
}

@code {
    [CascadingParameter]
    public ConsoleContext? Context { get; set; }

    private IReadOnlyList<AdminUserRow>? _rows;
    private string _query = string.Empty;
    private bool _busy;

    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task OnKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (Context is null)
        {
            return;
        }

        _busy = true;
        _rows = await Admin.SearchUsersAsync(Context.UserId, _query, 50);
        _busy = false;
    }

    private string Status(AdminUserRow row) => row.PurgeAfter is not null
        ? (row.OnHold ? L["deletion held"] : L["deleting"])
        : row.Status switch
        {
            UserStatus.Active => L["active"],
            UserStatus.Suspended => L["suspended"],
            UserStatus.DeletedSoft => L["deleting"],
            _ => L["deleted"],
        };
}
