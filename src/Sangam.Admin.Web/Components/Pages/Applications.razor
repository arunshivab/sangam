@page "/apps"
@inject IAdminService Admin

<PageTitle>Applications · Sangam console</PageTitle>

<h1 class="sg-h1">Applications</h1>
<p class="sg-lede">Every application registered with Sangam. Disabling one stops all of its sign-ins at once; it does not reach inside the application's own data. <em>Partner owners</em> are the application's own staff who manage it on the partner console; an application with none cannot be managed by its partner yet. Those marked <em>platform</em> are Sangam's own and can neither be disabled nor handed to a partner here.</p>

@if (_rows is null)
{
  <p class="sg-muted">Loading…</p>
}
else
{
  <table class="sg-table">
    <thead><tr><th>Application</th><th>Client id</th><th>Sign-in rule</th><th>Users</th><th>Orgs</th><th>Partner owners</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @foreach (AdminAppRow row in _rows)
      {
        <tr>
          <td><span class="sg-name">@row.DisplayName</span><span class="sg-sub">@row.OwnerCompanyName</span></td>
          <td class="sg-mono">@row.ClientId</td>
          <td class="sg-mono">@row.SignInPolicy.ToString().ToLowerInvariant()</td>
          <td>@row.Users</td>
          <td>@row.Organisations</td>
          <td>@if (row.IsPlatform) { <span class="sg-muted">—</span> } else if (row.PartnerOwners == 0) { <span class="sg-warn-text">none</span> } else { @row.PartnerOwners }</td>
          <td><span class="sg-pill sg-pill--@row.Status.ToString().ToLowerInvariant()">@row.Status.ToString().ToLowerInvariant()</span></td>
          <td>
            @if (row.IsPlatform)
            {
              <span class="sg-pill sg-pill--platform" title="Part of Sangam itself: never disabled here, never given partner owners">platform</span>
            }
            else if (Context?.CanManageApps == true)
            {
              <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => StartAssign(row)" disabled="@_busy">Assign owner</button>
              @if (row.Status == AppStatus.Active)
              {
                <button type="button" class="sg-btn sg-btn--warn" @onclick="() => _confirming = row" disabled="@_busy">Disable</button>
              }
              else
              {
                <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => SetAsync(row, AppStatus.Active)" disabled="@_busy">Enable</button>
              }
            }
          </td>
        </tr>
      }
    </tbody>
  </table>

  @if (Context?.CanManageApps != true)
  {
    <p class="sg-muted">Your rank (@Context?.RoleLabel) can see the registry but not change it.</p>
  }
}

@if (_confirming is not null)
{
  <div class="sg-confirm">
    <p><strong>Disable @_confirming.DisplayName?</strong> Every sign-in to it stops immediately, for all @_confirming.Users users who have granted it access. Tokens it already holds stay valid until they expire.</p>
    <div class="sg-actions">
      <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _confirming = null">Cancel</button>
      <button type="button" class="sg-btn sg-btn--danger" @onclick="() => SetAsync(_confirming, AppStatus.Disabled)" disabled="@_busy">Disable it</button>
    </div>
  </div>
}

@if (_assigning is not null)
{
  <div class="sg-confirm">
    <p><strong>Make someone an owner of @_assigning.DisplayName.</strong> They will be able to manage its roles, organisations, people, administrators and branding on the partner console — not its redirect addresses or secrets. They need an active, verified Sangam account, and must set up an authenticator app before the partner console opens.</p>
    <div class="sg-form-row">
      <label class="sg-label" for="owner-email">Their Sangam email address</label>
      <input id="owner-email" class="sg-input" type="email" autocomplete="off" @bind="_ownerEmail" @bind:event="oninput" />
    </div>
    <div class="sg-actions">
      <button type="button" class="sg-btn sg-btn--ghost" @onclick="() => _assigning = null">Cancel</button>
      <button type="button" class="sg-btn sg-btn--primary" @onclick="AssignAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_ownerEmail))">Make owner</button>
    </div>
  </div>
}

@if (_message is not null)
{
  <p class="@(_ok ? "sg-ok" : "sg-warn")">@_message</p>
}

@code {
    [CascadingParameter]
    public ConsoleContext? Context { get; set; }

    private IReadOnlyList<AdminAppRow>? _rows;
    private AdminAppRow? _confirming;
    private AdminAppRow? _assigning;
    private string _ownerEmail = string.Empty;
    private bool _busy;
    private bool _ok;
    private string? _message;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Context is not null)
        {
            _rows = await Admin.ListAppsAsync(Context.UserId);
        }
    }

    private void StartAssign(AdminAppRow row)
    {
        _confirming = null;
        _assigning = row;
        _ownerEmail = string.Empty;
        _message = null;
    }

    private async Task AssignAsync()
    {
        _busy = true;
        AdminResult result = await Admin.AssignAppOwnerAsync(Context!.UserId, _assigning!.Id, _ownerEmail, null);
        _busy = false;
        _ok = result.Succeeded;
        _message = result.Message;
        if (result.Succeeded)
        {
            _assigning = null;
        }

        await LoadAsync();
    }

    private async Task SetAsync(AdminAppRow row, AppStatus status)
    {
        _busy = true;
        AdminResult result = await Admin.SetAppStatusAsync(Context!.UserId, row.Id, status, null);
        _busy = false;
        _confirming = null;
        _ok = result.Succeeded;
        _message = result.Message;
        await LoadAsync();
    }
}
