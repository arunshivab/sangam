<div class="sg-side-foot">
  @if (Context is not null)
  {
    <span class="sg-name">@Context.Name</span>
    <span class="sg-rank sg-rank--@Context.Role.ToString().ToLowerInvariant()">@L[Context.RoleLabel]</span>
  }
  <a class="sg-side-out" href="/signout">@L["Sign out"]</a>
  <LanguagePicker />
</div>

@code {
    /// <summary>The signed-in operator, cascaded by the gate.</summary>
    [CascadingParameter]
    public ConsoleContext? Context { get; set; }
}
