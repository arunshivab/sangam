@inject IAdminService Admin
@inject IMfaService Mfa
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

@if (_state == GateState.Checking)
{
    <p class="sg-note">@L["Checking your access…"]</p>
}
else if (_state == GateState.NotAnOperator)
{
    <section class="sg-shut">
        <h1 class="sg-shut-title">@L["This console is not for you"]</h1>
        <p class="sg-shut-body">
            @L["Your Sangam account is fine — it simply does not hold platform operator access. If that is wrong, ask an owner to grant it. Nothing about this page is logged against you beyond the sign-in itself."]
        </p>
        <a class="sg-btn sg-btn--secondary" href="/signout">@L["Sign out"]</a>
    </section>
    <footer class="sg-lang-footer"><LanguagePicker /></footer>
}
else if (_state == GateState.MfaRequired)
{
    <section class="sg-shut">
        <h1 class="sg-shut-title">@L["Set up two-step sign-in first"]</h1>
        <p class="sg-shut-body">
            @L["Operators must have an authenticator app. Open your Sangam account portal, set one up under Sign-in & security, then sign in here again."]
        </p>
        <a class="sg-btn sg-btn--primary" href="@PortalUrl">@L["Go to your account portal"]</a>
        <a class="sg-btn sg-btn--secondary" href="/signout">@L["Sign out"]</a>
    </section>
    <footer class="sg-lang-footer"><LanguagePicker /></footer>
}
else if (_state == GateState.TwoStepRequired)
{
    <section class="sg-shut" data-panel="two-step-required">
        <h1 class="sg-shut-title">@L["Sign in again with two-step sign-in"]</h1>
        <p class="sg-shut-body">
            @L["The console opens only for a sign-in that used two-step sign-in or a passkey, and this one did not. Sign in again: Sangam will ask for your authenticator app or your passkey."]
        </p>
        <a class="sg-btn sg-btn--primary" href="@ReauthUrl">@L["Sign in again"]</a>
        <a class="sg-btn sg-btn--secondary" href="/signout">@L["Sign out"]</a>
    </section>
    <footer class="sg-lang-footer"><LanguagePicker /></footer>
}
else
{
    <CascadingValue Value="_context">@ChildContent</CascadingValue>
}

@code {
    /// <summary>The console, shown only once every bar is cleared.</summary>
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Where to send an operator who still needs an authenticator.</summary>
    [Parameter]
    public string PortalUrl { get; set; } = "https://account.sangamid.in/security";

    private GateState _state = GateState.Checking;
    private ConsoleContext _context = new(Guid.Empty, PlatformRole.Viewer, "Operator");

    private string ReauthUrl => "/reauth?returnUrl=" + Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri));

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        Guid? userId = OperatorContext.Id(state.User);
        if (userId is null)
        {
            _state = GateState.NotAnOperator;
            return;
        }

        PlatformRole? role = await Admin.GetRoleAsync(userId.Value);
        if (role is null)
        {
            _state = GateState.NotAnOperator;
            return;
        }

        // Mandatory, and checked here rather than trusted from the sign-in: an operator granted
        // access while signed in must still enrol before the console opens.
        if (!await Mfa.IsEnrolledAsync(userId.Value))
        {
            _state = GateState.MfaRequired;
            return;
        }

        // rc.10: having an authenticator is not enough; this session must have been signed in with it (or a passkey).
        if (!ConsoleSession.IsTwoStep(state.User))
        {
            _state = GateState.TwoStepRequired;
            return;
        }

        _context = new ConsoleContext(userId.Value, role.Value, OperatorContext.Name(state.User))
        {
            SignInLevel = ConsoleSession.Level(state.User),
            SessionEndsAt = ConsoleSession.EndsAt(state.User),
        };
        _state = GateState.Open;
    }

    private enum GateState
    {
        Checking,
        NotAnOperator,
        MfaRequired,
        TwoStepRequired,
        Open,
    }
}
